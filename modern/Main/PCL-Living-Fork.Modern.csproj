<Target Name="WriteDevelopmentBuildTime" BeforeTargets="CoreCompile" Condition="'$(LFOfficialRelease)' != 'true'"
        Inputs="$(MSBuildAllProjects);@(Compile);@(Page);@(ApplicationDefinition);@(Resource);@(EmbeddedResource);@(ReferencePathWithRefAssemblies)"
        Outputs="$(IntermediateOutputPath)DevelopmentBuildTime.g.cs">
  <ItemGroup>
    <_DevelopmentMetadata Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PCL.DevelopmentBuildUtc</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</_Parameter2>
    </_DevelopmentMetadata>
    <Compile Include="$(IntermediateOutputPath)DevelopmentBuildTime.g.cs" />
    <FileWrites Include="$(IntermediateOutputPath)DevelopmentBuildTime.g.cs" />
  </ItemGroup>
  <WriteCodeFragment Language="C#" AssemblyAttributes="@(_DevelopmentMetadata)" OutputFile="$(IntermediateOutputPath)DevelopmentBuildTime.g.cs" />
</Target>
