<local:GlassWorkspacePage x:Class="PCL.PageInstanceMod"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core">
    <Grid>
        <Grid x:Name="PanAllBack">
            <Grid x:Name="PanBack" Margin="25,10,25,12" Focusable="True">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <StackPanel x:Name="PanMain">
                    <TextBox x:Name="SearchBox" Margin="0,0,0,10" Style="{DynamicResource GlassPresentationTextBox}" />
                    <glass:GlassSurface x:Name="PanManage" Padding="12,10" Margin="0,0,0,12" CornerRadius="14"
                        Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}"
                        BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                        <WrapPanel>
                            <Button x:Name="BtnManageOpen" Content="打开文件夹" Style="{DynamicResource GlassPresentationAccentButton}" Margin="0,0,8,5" />
                            <Button x:Name="BtnManageInstall" Content="从文件安装" Style="{DynamicResource GlassPresentationButton}" Margin="0,0,8,5" />
                            <Button x:Name="BtnManageDownload" Content="下载新 Mod" Style="{DynamicResource GlassPresentationButton}" Margin="0,0,8,5" />
                            <Button x:Name="BtnManageSelectAll" Content="全选" Style="{DynamicResource GlassPresentationButton}" Margin="0,0,8,5" />
                            <Button x:Name="BtnManageIndex" Content="更新依赖索引" Style="{DynamicResource GlassPresentationButton}" Margin="0,0,8,5"
                                ToolTip="重新读取模组及平台依赖声明，并保存到依赖树索引。" />
                        </WrapPanel>
                    </glass:GlassSurface>
                </StackPanel>
                <glass:GlassSurface x:Name="PanListBack" Grid.Row="1" VerticalAlignment="Top" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Margin="0,0,0,18"
                    Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}"
                    BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                        <DockPanel x:Name="PanSortHeader" Margin="15,0,15,7">
                            <Button x:Name="BtnSort" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{DynamicResource GlassPresentationButton}"
                                ToolTip="切换本地创建时间的正序与倒序。" />
                            <WrapPanel x:Name="PanFilter">
                                <RadioButton x:Name="BtnFilterAll" Content="全部" Tag="0" IsChecked="True" Style="{DynamicResource GlassResourceFilter}" />
                                <RadioButton x:Name="BtnFilterEnabled" Content="已启用" Tag="1" Style="{DynamicResource GlassResourceFilter}" />
                                <RadioButton x:Name="BtnFilterDisabled" Content="已禁用" Tag="2" Style="{DynamicResource GlassResourceFilter}" />
                                <RadioButton x:Name="BtnFilterCanUpdate" Content="可更新" Tag="3" Style="{DynamicResource GlassResourceFilter}" />
                                <RadioButton x:Name="BtnFilterDuplicate" Content="重复" Tag="4" Style="{DynamicResource GlassResourceFilter}" />
                            </WrapPanel>
                        </DockPanel>
                        <ItemsControl x:Name="PanList" Grid.Row="1" VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page" ClipToBounds="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer x:Name="RowsScroll" Style="{DynamicResource GlassPresentationScrollViewer}" Padding="20,0,18,0" CanContentScroll="True"
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </glass:GlassSurface>
            </Grid>
            <glass:GlassSurface x:Name="PanEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="30" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}"
                BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                <StackPanel MaxWidth="600">
                    <TextBlock x:Name="LabEmptyTitle" Text="尚未安装 Mod" FontSize="19" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LabEmptyHint" Margin="0,10" TextWrapping="Wrap" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button x:Name="BtnHintDownload" Content="下载 Mod" Style="{DynamicResource GlassPresentationAccentButton}" Margin="0,0,8,5" />
                        <Button x:Name="BtnHintInstall" Content="从文件安装 Mod" Style="{DynamicResource GlassPresentationButton}" Margin="0,0,8,5" />
                        <Button x:Name="BtnHintOpen" Content="打开 Mod 文件夹" Style="{DynamicResource GlassPresentationButton}" Margin="0,0,8,5" />
                    </WrapPanel>
                </StackPanel>
            </glass:GlassSurface>
        </Grid>
        <glass:GlassSurface x:Name="PanLoad" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}"
            BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
            <StackPanel>
                <glass:BlockCurveLoader x:Name="Load" Width="38" Height="38" HorizontalAlignment="Center" Foreground="{DynamicResource GlassPresentationAccent}" />
                <TextBlock x:Name="LabLoad" Text="正在读取模组…" Margin="0,8" TextAlignment="Center" />
                <Button x:Name="BtnRetry" Content="重试" Visibility="Collapsed" Style="{DynamicResource GlassPresentationButton}" HorizontalAlignment="Center" />
            </StackPanel>
        </glass:GlassSurface>
        <local:GlassSelectionDock x:Name="CardSelect" />
    </Grid>
</local:GlassWorkspacePage>
