<local:GlassWorkspacePage x:Class="PCL.PageInstanceClone"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PCL"
 xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core">
 <ScrollViewer x:Name="PanBack" Style="{DynamicResource GlassPresentationScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <!-- The clone workflow as numbered steps: create a copy, test it, then migrate the result back. -->
  <StackPanel Margin="25,10">
   <local:GlassStepCard Number="1" Title="创建测试副本" IsPrimary="True" Margin="0,15,0,0"
       Description="游戏本体、加载器、Mod、配置、按键、资源包和光影包会复制到独立目录。">
    <StackPanel>
     <TextBlock x:Name="LabSource" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource GlassPresentationSecondary}" Margin="0,0,0,8" />
     <local:GlassSettingRowStack>
      <local:GlassSettingItem Title="副本名称" Description="副本会作为一个新版本出现在版本列表中。">
       <Grid x:Name="NameEditor" Width="260"><TextBox x:Name="TextName" MaxLength="100" Style="{DynamicResource GlassPresentationTextBox}" /></Grid>
      </local:GlassSettingItem>
      <local:GlassSettingItem Title="复制存档" Description="用副本测试当前世界。副本中的世界进度不会自动迁移回原版本。">
       <CheckBox Style="{DynamicResource GlassPresentationSwitch}" x:Name="CheckSaves" />
      </local:GlassSettingItem>
      <local:GlassSettingItem Title="复制截图">
       <CheckBox Style="{DynamicResource GlassPresentationSwitch}" x:Name="CheckScreenshots" />
      </local:GlassSettingItem>
      <local:GlassSettingItem Title="复制服务器列表" Description="只复制 servers.dat 和 servers.dat_old，不复制账号登录资料。">
       <CheckBox Style="{DynamicResource GlassPresentationSwitch}" x:Name="CheckServers" />
      </local:GlassSettingItem>
     </local:GlassSettingRowStack>
     <TextBlock x:Name="LabValidation" TextWrapping="Wrap" Foreground="{DynamicResource GlassPresentationWarnText}" Margin="0,6,0,0" />
     <Button Style="{DynamicResource GlassPresentationAccentButton}" x:Name="BtnClone" Content="创建测试副本" HorizontalAlignment="Left" Margin="0,12,0,0" />
    </StackPanel>
   </local:GlassStepCard>
   <local:GlassStepCard Number="2" Title="在副本中测试"
       Description="在版本列表中选择副本并启动。可以放心升级 Mod、更换加载器或调整配置。" />
   <local:GlassStepCard Number="3" Title="迁移回原版本" IsLast="True"
       Description="在测试副本的这个页面中预览变更：Mod、配置和游戏组件的差异会先列出，迁移前会保存原环境的还原点。">
    <glass:GlassSurface x:Name="CardOrigin" Visibility="Collapsed" Padding="14,12" CornerRadius="10" Background="{DynamicResource GlassPresentationField}" BorderBrush="{DynamicResource GlassPresentationControlStroke}" BorderThickness="0.7" BlurRadius="0" TintOpacity="1" HighlightOpacity="0">
     <StackPanel>
      <TextBlock x:Name="LabOrigin" TextWrapping="Wrap" Margin="0,0,0,12" />
      <Button Style="{DynamicResource GlassPresentationAccentButton}" x:Name="BtnMigrate" Content="预览迁移到原版本" HorizontalAlignment="Left" />
     </StackPanel>
    </glass:GlassSurface>
   </local:GlassStepCard>
  </StackPanel>
 </ScrollViewer>
</local:GlassWorkspacePage>
