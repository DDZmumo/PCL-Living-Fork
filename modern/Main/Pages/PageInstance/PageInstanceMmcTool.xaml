<local:GlassWorkspacePage x:Class="PCL.PageInstanceMmcTool"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core"
   >
    <ScrollViewer x:Name="PanBack" Style="{DynamicResource GlassPresentationScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <Border x:Name="HintStatus" CornerRadius="8" BorderThickness="0.7" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" />
            </Border>
            <glass:GlassSurface x:Name="CardAction" Margin="0,0,0,15" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                <StackPanel>
                    <TextBlock x:Name="LabActionTitle" Text="MMC 实例工具" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock x:Name="LabInstanceInfo" TextWrapping="Wrap" FontSize="13.5" Margin="0,0,0,8" />
                    <TextBlock x:Name="LabToolDescription" TextWrapping="Wrap" Opacity="0.78" Margin="0,0,0,15" />
                    <StackPanel x:Name="PanCloneOptions" Visibility="Collapsed" Margin="0,0,0,15">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="新实例名称" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <TextBox Grid.Column="1" x:Name="TextCloneName" MaxLength="100" Style="{DynamicResource GlassPresentationTextBox}" />
                        </Grid>
                        <TextBlock Text="游戏本体、加载器、模组、组件配置与环境变量会复制到独立目录。" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,10" />
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckCopySaves" Content="复制存档" Height="27" ToolTip="复制当前世界存档到新实例。" />
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckCopyScreenshots" Content="复制截图" Height="27" Margin="0,5,0,0" />
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckCopyServers" Content="复制服务器列表" Height="27" Margin="0,5,0,0" ToolTip="仅复制服务器列表文件，账号登录信息不会复制。" />
                        <TextBlock x:Name="LabCloneValidation" TextWrapping="Wrap" Foreground="{DynamicResource GlassPresentationWarnText}" Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <WrapPanel>
                        <Button Style="{DynamicResource GlassPresentationAccentButton}" x:Name="BtnPrimaryAction" MinWidth="150" Height="35" Padding="15,0" Margin="0,0,15,6" Click="BtnPrimaryAction_Click" />
                        <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnRefreshTool" Content="刷新状态" MinWidth="110" Height="35" Padding="13,0" Margin="0,0,15,6" Click="BtnRefreshTool_Click" />
                    </WrapPanel>
                </StackPanel>
            </glass:GlassSurface>
            <glass:GlassSurface x:Name="CardRecovery" Margin="0,0,0,15" Visibility="Collapsed" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                <StackPanel>
                    <TextBlock Text="状态与恢复" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock x:Name="LabRecoveryMessage" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <WrapPanel>
                        <Button Style="{DynamicResource GlassPresentationAccentButton}" x:Name="BtnRepairInstance" Content="修复 MMC 实例" MinWidth="140" Height="35" Padding="14,0" Margin="0,0,15,6" Visibility="Collapsed" Click="BtnRepairInstance_Click" />
                        <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnRecoveryRefresh" Content="重新检查状态" MinWidth="120" Height="35" Padding="13,0" Margin="0,0,15,6" Click="BtnRefreshTool_Click" />
                    </WrapPanel>
                </StackPanel>
            </glass:GlassSurface>
        </StackPanel>
    </ScrollViewer>
</local:GlassWorkspacePage>
