<local:GlassWorkspacePage x:Class="PCL.PageInstanceKeybindings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core">
    <Grid>
        <ScrollViewer x:Name="PanBack" Style="{DynamicResource GlassPresentationScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,10">
                <Grid x:Name="SearchHost" Margin="0,15">
                    <TextBox x:Name="SearchBox" Style="{DynamicResource GlassPresentationTextBox}" ToolTip="点击右侧键位按钮后重新绑定，Esc 取消。模组归属依据本地语言资源识别。" />
                </Grid>
                <glass:GlassSurface x:Name="CardBindings" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0" Margin="0,0,0,15" MinHeight="80">
                    <StackPanel>
                        <WrapPanel>
                            <RadioButton x:Name="BtnFilterAll" Content="全部" Style="{DynamicResource GlassResourceFilter}" IsChecked="True" Margin="2,0" />
                            <RadioButton x:Name="BtnFilterConflicts" Content="同键占用" Style="{DynamicResource GlassResourceFilter}" Margin="2,0" ToolTip="不同界面可能复用同一按键，同键占用不一定代表冲突。" />
                        </WrapPanel>
                        <TextBlock x:Name="LabEmpty" Foreground="{DynamicResource GlassPresentationSecondary}" Margin="5,0,5,8" />
                        <StackPanel x:Name="PanBindings" />
                    </StackPanel>
                </glass:GlassSurface>
            </StackPanel>
        </ScrollViewer>
        <local:GlassSelectionDock x:Name="CardCapture" />
        <glass:GlassSurface x:Name="PanLoad" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
            <StackPanel MaxWidth="360">
                <glass:BlockCurveLoader x:Name="Load" Width="36" Height="36" HorizontalAlignment="Center" Foreground="{DynamicResource GlassPresentationAccent}" />
                <TextBlock x:Name="LabLoad" TextAlignment="Center" Margin="0,10" />
                <Button x:Name="BtnRetry" Content="重试" Visibility="Collapsed" HorizontalAlignment="Center" Style="{DynamicResource GlassPresentationButton}" />
            </StackPanel>
        </glass:GlassSurface>
    </Grid>
</local:GlassWorkspacePage>
