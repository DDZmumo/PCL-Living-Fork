<local:GlassWorkspacePage x:Class="PCL.PageInstanceRestorePoints"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PCL" xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core">
 <Grid>
  <ScrollViewer x:Name="PanBack" Style="{DynamicResource GlassPresentationScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="25,10">
    <TextBox x:Name="SearchBox" Style="{DynamicResource GlassPresentationTextBox}" Margin="0,15" />
    <glass:GlassSurface Margin="0,0,0,15" Padding="18,14" CornerRadius="14" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
     <WrapPanel>
      <Button Style="{DynamicResource GlassPresentationAccentButton}" x:Name="BtnFolder" Content="打开文件夹" />
      <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnCreate" Content="创建还原点" />
      <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnSelectAll" Content="全选" />
      <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnMmcUndo" Content="撤回上次还原" Visibility="Collapsed" IsEnabled="False" />
     </WrapPanel>
    </glass:GlassSurface>
    <Border x:Name="HintMmcHistory" Visibility="Collapsed" Margin="0,0,0,15" CornerRadius="8" BorderThickness="0.7" Padding="11,8">
     <TextBlock TextWrapping="Wrap" />
    </Border>
    <local:GlassSettingGroup x:Name="CardRetention" Title="还原点设置" IsEnabled="False">
     <local:GlassSettingItem Description="跟随“设置 → 其他”中的全局默认，或为这个实例单独设置。">
      <local:GlassSettingItem.TitleContent><TextBlock x:Name="LabHistorySource" Text="配置来源" /></local:GlassSettingItem.TitleContent>
      <ComboBox Style="{DynamicResource GlassPresentationComboBox}" x:Name="ComboRetentionMode" SelectionChanged="RetentionModeChanged">
       <ComboBoxItem Content="跟随全局设置" />
       <ComboBoxItem Content="实例独立配置" />
      </ComboBox>
     </local:GlassSettingItem>
     <local:GlassSettingRowStack x:Name="PanIndependentRetention" Visibility="Collapsed">
      <local:GlassSettingItem Description="启动游戏或修改环境前记录一个还原点。">
       <local:GlassSettingItem.TitleContent><TextBlock x:Name="LabHistoryAutoCreate" Text="自动创建" /></local:GlassSettingItem.TitleContent>
       <CheckBox Style="{DynamicResource GlassPresentationSwitch}" x:Name="CheckHistoryAutoCreate" />
      </local:GlassSettingItem>
      <local:GlassSettingItem Description="只限制自动还原点的数量，手动还原点不计入。">
       <local:GlassSettingItem.TitleContent><TextBlock x:Name="LabHistoryPolicy" Text="保留策略" /></local:GlassSettingItem.TitleContent>
       <ComboBox Style="{DynamicResource GlassPresentationComboBox}" x:Name="ComboHistoryRetentionPolicy" SelectionChanged="HistoryRetentionPolicyChanged">
        <ComboBoxItem Content="全部保留" />
        <ComboBoxItem Content="保留最近若干份" />
       </ComboBox>
      </local:GlassSettingItem>
      <local:GlassSettingRowStack x:Name="PanRetention" Visibility="Collapsed">
       <local:GlassSettingItem Description="保留的自动还原点数量，范围 1 到 100。">
        <local:GlassSettingItem.TitleContent><TextBlock x:Name="LabHistoryCount" Text="保留份数" /></local:GlassSettingItem.TitleContent>
        <StackPanel Orientation="Horizontal">
         <glass:GlassValidatedTextBox Style="{DynamicResource GlassPresentationTextBox}" x:Name="TextRetention" Width="72" MaxLength="3" Text="10">
          <glass:GlassValidatedTextBox.ValidateRules><local:ValidateInteger Min="1" Max="100" /></glass:GlassValidatedTextBox.ValidateRules>
         </glass:GlassValidatedTextBox>
         <TextBlock Text="个" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource GlassPresentationSecondary}" />
        </StackPanel>
       </local:GlassSettingItem>
      </local:GlassSettingRowStack>
     </local:GlassSettingRowStack>
    </local:GlassSettingGroup>
    <glass:GlassSurface x:Name="CardList" Margin="0,0,0,14" MinHeight="55" VerticalAlignment="Top" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
     <StackPanel>
      <WrapPanel>
      <RadioButton Style="{DynamicResource GlassResourceFilter}" x:Name="FilterAll" Content="全部" IsChecked="True" Margin="2,0" />
      <RadioButton Style="{DynamicResource GlassResourceFilter}" x:Name="FilterHealthy" Content="正常运行" Margin="2,0" />
      </WrapPanel>
      <TextBlock x:Name="LabEmpty" Text="暂无还原点。" Opacity="0.65" TextWrapping="Wrap" Margin="5,0,5,8" />
      <StackPanel x:Name="PanEntries" />
     </StackPanel>
    </glass:GlassSurface>
   </StackPanel>
  </ScrollViewer>
  <glass:GlassSurface x:Name="PanLoad" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,14" CornerRadius="14" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
   <StackPanel>
    <glass:BlockCurveLoader x:Name="Load" Width="38" Height="38" HorizontalAlignment="Center" Foreground="{DynamicResource GlassPresentationAccent}" />
    <TextBlock x:Name="LabLoad" TextAlignment="Center" Margin="0,8" />
    <Button x:Name="BtnRetry" Content="重试" Style="{DynamicResource GlassPresentationButton}" HorizontalAlignment="Center" Visibility="Collapsed" />
   </StackPanel>
  </glass:GlassSurface>
  <local:GlassSelectionDock x:Name="CardSelect" />
 </Grid>
</local:GlassWorkspacePage>
