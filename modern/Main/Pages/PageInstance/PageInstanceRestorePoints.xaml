<local:MyPageRight x:Class="PCL.PageInstanceRestorePoints"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
 <Grid>
  <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="25,10">
    <local:MySearchBox x:Name="SearchBox" Margin="0,15" HintText="搜索还原点 / 版本 / 时间" />
    <local:MyCard Margin="0,0,0,15">
     <Grid Margin="15,15,0,15" Height="35" Grid.IsSharedSizeScope="True">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Button"/><ColumnDefinition Width="Auto" SharedSizeGroup="Button"/><ColumnDefinition Width="Auto" SharedSizeGroup="Button"/></Grid.ColumnDefinitions>
      <local:MyButton x:Name="BtnFolder" Text="打开文件夹" ColorType="Highlight" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
      <local:MyButton x:Name="BtnCreate" Text="创建还原点" Grid.Column="1" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
      <local:MyButton x:Name="BtnSelectAll" Text="全选" Grid.Column="2" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
 </Grid>
    </local:MyCard>
    <local:MyCard x:Name="CardRetention" Title="保留设置" Margin="0,0,0,15" IsEnabled="False">
     <StackPanel Margin="25,40,25,20">
      <local:MyCheckBox x:Name="CheckAutoCleanup" Text="自动清理超过上限的旧还原点" ToolTip="手动还原点不计入上限。新还原点保存成功后，才会清理最旧的自动还原点。" />
      <StackPanel x:Name="PanRetention" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
       <TextBlock Text="保留最近" VerticalAlignment="Center" Margin="0,0,10,0" />
       <local:MyTextBox x:Name="TextRetention" Width="65" MaxLength="3" Text="10" ShowValidateResult="False" ToolTip="允许 1 到 100 个自动还原点，手动还原点不计入。">
        <local:MyTextBox.ValidateRules><local:ValidateInteger Min="1" Max="100" /></local:MyTextBox.ValidateRules>
       </local:MyTextBox>
       <TextBlock Text="个自动还原点" VerticalAlignment="Center" Margin="10,0,0,0" />
      </StackPanel>
     </StackPanel>
    </local:MyCard>
    <local:MyCard x:Name="CardList" Title=" " Margin="0,0,0,14" MinHeight="55" VerticalAlignment="Top">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,13,0,0" Height="28">
      <local:MyRadioButton x:Name="FilterAll" Text="全部" ColorType="Highlight" Checked="True" Margin="2,0" />
      <local:MyRadioButton x:Name="FilterHealthy" Text="正常运行" ColorType="Highlight" Margin="2,0" />
     </StackPanel>
     <StackPanel Margin="20,48,18,22">
      <TextBlock x:Name="LabEmpty" Text="暂无还原点。更新前会自动保存，也可以手动创建。" Opacity="0.65" TextWrapping="Wrap" Margin="5,0,5,8" />
      <StackPanel x:Name="PanEntries" />
     </StackPanel>
    </local:MyCard>
   </StackPanel>
  </local:MyScrollViewer>
  <local:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" UseAnimation="False">
   <local:MyLoading x:Name="Load" Text="正在读取还原点" Margin="20,20,20,17" />
  </local:MyCard>
  <local:MyCard x:Name="CardSelect" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="25,25,25,0" UseAnimation="False">
   <local:MyCard.RenderTransform><TranslateTransform x:Name="TransSelect" Y="-10" /></local:MyCard.RenderTransform>
   <TextBlock x:Name="LabSelect" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="9" Foreground="{DynamicResource ColorBrush2}" />
   <StackPanel Orientation="Horizontal" Margin="5,28,5,5">
    <local:MyIconTextButton x:Name="BtnRestore" Text="恢复" IsEnabled="False" />
    <local:MyIconTextButton x:Name="BtnDelete" Text="删除" />
    <local:MyIconTextButton x:Name="BtnDeselect" Text="取消选择" />
   </StackPanel>
  </local:MyCard>
 </Grid>
</local:MyPageRight>
