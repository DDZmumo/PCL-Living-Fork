<local:GlassWorkspacePage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:System="clr-namespace:System;assembly=mscorlib" 
    mc:Ignorable="d" x:Class="PCL.PageInstanceExport"
    xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core">
    <Grid x:Name="PanAllBack">
        <Grid.Resources>
            <Style TargetType="CheckBox">
                <Setter Property="Height" Value="26" />
            </Style>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack" Style="{DynamicResource GlassPresentationScrollViewer}">
            <StackPanel Margin="25,10,25,65">
                <Border Margin="0,15,0,0" x:Name="HintOptiFine" Background="{DynamicResource GlassPresentationWarnFill}" BorderBrush="{DynamicResource GlassPresentationWarnEdge}" CornerRadius="8" BorderThickness="0.7" Padding="10,7"><TextBlock Text="受 Modrinth 整合包规范限制，导出的整合包中不会包含 OptiFine。" Foreground="{DynamicResource GlassPresentationWarnText}" /></Border>
                <glass:GlassSurface BlurRadius="24" Margin="0,15,0,0" x:Name="HintJava" Background="{DynamicResource GlassPresentationWarnFill}" BorderBrush="{DynamicResource GlassPresentationWarnEdge}" CornerRadius="8" BorderThickness="0.7" Padding="10,7"><TextBlock Text="" Foreground="{DynamicResource GlassPresentationWarnText}" /></glass:GlassSurface>
                <glass:GlassSurface Margin="0,0,0,18" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0.3*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="整合包名称" Margin="0,0,20,0" />
                        <glass:GlassValidatedTextBox Style="{DynamicResource GlassPresentationTextBox}" Grid.Row="0" Grid.Column="1" x:Name="TextExportName" MaxLength="100" />
                        <TextBlock x:Name="LabExportVersion" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="整合包版本" Margin="30,0,20,0" />
                        <glass:GlassValidatedTextBox Style="{DynamicResource GlassPresentationTextBox}" Grid.Row="0" Grid.Column="3" x:Name="TextExportVersion" Tag="VersionArgumentTitle" MaxLength="100" />
                    </Grid>
                </glass:GlassSurface>
                <glass:GlassSurface Margin="0,0,0,15" x:Name="CardOptions" MinHeight="39" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                    <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                    <Button x:Name="BtnOverrideCancel" DockPanel.Dock="Right" Content="重置" Height="31" Style="{DynamicResource GlassPresentationButton}" IsHitTestVisible="False" Opacity="0.5" />
                        <TextBlock x:Name="LabOptionsTitle" Text="导出内容列表" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Name="PanOptions">
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" IsEnabled="False" x:Name="CheckOptionsBasic">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="游戏本体"
                                DefaultChecked="True" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsOptions" Margin="30,0,0,0">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="游戏本体设置"
                                Description="键位、音量、视频设置等"
                                Rules="options.txt|configureddefaults/"
                                DefaultChecked="True" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" Margin="30,0,0,0">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="游戏本体个人信息"
                                Description="命令历史、已保存的快捷栏"
                                Rules="hotbar.nbt|command_history.txt"
                                DefaultChecked="False" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" Margin="30,0,0,0">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                 Title="OptiFine 设置"
                                 Rules="optionsof.txt|optionsshaders.txt"
                                 DefaultChecked="True"
                                 RequireOptiFine="True" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsMod">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="Mod"
                                Description="模组"
                                Rules="mods/|!mods/*.disabled|!mods/*.old|!mods/.connector/|coremods/|lib/"
                                DefaultChecked="True"
                                RequireModLoader="True" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <UniformGrid Columns="2" Margin="30,0,0,0"
                                Visibility="{Binding IsChecked, ElementName=CheckOptionsMod, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="已禁用的 Mod"
                                Rules="mods/*.disabled|mods/*.old" />
                                </CheckBox.Tag>
                            </CheckBox>
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="整合包重要数据"
                                Description="脚本文件、内置资源包、数据包等"
                                Rules="hotai/|bansoukou/|addons/|multiblocked/|modpack-update-checker/|global_packs/|global_resource_packs/|global_data_packs/|optional_data_packs/|moonlight-global-datapacks/|maps/|icon.png|mods-resourcepacks/|matmos/|resource_assorts/|resource_assorts.json|patchouli_books/|datapacks/|kubejs*/|!kubejs*/probe/|!kubejs*/exported/|!kubejs*/jsconfig.json|!kubejs*/README.txt|openloader/|worldshape/|resources/|scripts/|structures/|fontfiles/|oresources/|packmenu/|craftpresence/|pointblanks/|template*/|!template*/playerdata/|!template*/stats/"
                                DefaultChecked="True" />
                                </CheckBox.Tag>
                            </CheckBox>
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="Mod 设置"
                                Rules="config/|!config/jei/world/|!config/worldedit/|config/worldedit/worldedit.properties|!config/spark/|config/spark/config.json|defaultconfigs/|journeymap/config/|journeymap/server/|TrashSlotSaveState.json|customfov.txt|gg.essential.mod/|essential/|!essential/*/|!essential/*.jar*|!essential/screenshot-checksum-caches.json|!essential/microsoft_accounts.json|paragliderSettings.nbt|local/client_config.json|local/ftbl.json|local/client/sidebar_buttons.json|local/client/ftbutilities.cfg|local/client/ftblib.cfg|local/client/xencraft.cfg|liteloader.properties|default_reference.xml|CustomSkinLoader/CustomSkinLoader.json|!config/tacz/custom"
                                DefaultChecked="True" />
                                </CheckBox.Tag>
                            </CheckBox>
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="TaCZ 枪包"
                                Rules="tacz/|config/tacz/custom/"
                                DefaultChecked="True" />
                                </CheckBox.Tag>
                            </CheckBox>
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="已上传的沉浸画"
                                Rules="immersive_paintings/"
                                DefaultChecked="True" />
                                </CheckBox.Tag>
                            </CheckBox>
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="已绘制的地图"
                                Description="地图类 Mod 为现有的存档、服务器记录的地图、路标点等"
                                Rules="journeymap/data/|xaero/|XaeroWaypoints/|XaeroWorldMap/"
                                DefaultChecked="False" />
                                </CheckBox.Tag>
                            </CheckBox>
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="JEI 个人信息"
                                Description="物品收藏夹等"
                                Rules="config/jei/world/"
                                DefaultChecked="False" />
                                </CheckBox.Tag>
                            </CheckBox>
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="EMI 个人信息"
                                Description="物品收藏夹、默认配方、合成历史记录等"
                                Rules="emi.json"
                                DefaultChecked="False" />
                                </CheckBox.Tag>
                            </CheckBox>
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="帕秋莉手册个人信息"
                                Description="教程书的已读记录、书签、阅读历史记录等"
                                Rules="patchouli_data.json"
                                DefaultChecked="False" />
                                </CheckBox.Tag>
                            </CheckBox>
                        </UniformGrid>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsResourcePacks">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="资源包"
                                Description="纹理包/材质包"
                                ShowRules="resourcepacks/|texturepacks/"
                                DefaultChecked="True" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <UniformGrid Columns="2" Margin="30,0,0,0" x:Name="PanOptionsResourcePacks"
                                Visibility="{Binding IsChecked, ElementName=CheckOptionsResourcePacks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        </UniformGrid>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsShaderPacks">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="光影包"
                                ShowRules="shaderpacks/"
                                DefaultChecked="True"
                                RequireModLoaderOrOptiFine="True" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <UniformGrid Columns="2" Margin="30,0,0,0"
                                Visibility="{Binding IsChecked, ElementName=CheckOptionsShaderPacks, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsShaderPackSettings">
                                <CheckBox.Tag>
                                    <local:ExportOption
                                Title="光影包设置"
                                Description="已选光影包的自定义设置"
                                ShowRules="shaderpacks/*.txt"
                                DefaultChecked="True" />
                                </CheckBox.Tag>
                            </CheckBox>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="30,0,0,0" x:Name="PanOptionsShaderPacks"
                                Visibility="{Binding IsChecked, ElementName=CheckOptionsShaderPacks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        </UniformGrid>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsScreenshots">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="截图"
                                Rules="screenshots/"
                                DefaultChecked="False" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="导出的结构"
                                Description="schematics 文件夹"
                                Rules="schematics/"
                                DefaultChecked="False" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="录像回放"
                                Description="Replay Mod 的录像文件"
                                Rules="replay_recordings/|replay_videos/"
                                RequireModLoader="True"
                                DefaultChecked="False" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsSaves">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="单人游戏存档"
                                Description="世界/地图"
                                ShowRules="saves/"
                                DefaultChecked="False" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <UniformGrid Columns="2" Margin="30,0,0,0" x:Name="PanOptionsSaves"
                                Visibility="{Binding IsChecked, ElementName=CheckOptionsSaves, Converter={StaticResource BooleanToVisibilityConverter}}">
                        </UniformGrid>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="协议"
                                Description="Licence 文件"
                                Rules="LICEN*"
                                DefaultChecked="True" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsServers">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="多人游戏服务器列表"
                                Rules="servers.dat"
                                DefaultChecked="False" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsJava">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="版本文件夹中的 Java"
                                DefaultChecked="True" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsPcl">
                            <CheckBox.Tag>
                                <local:ExportOption 
                                Title="PCL 启动器程序"
                                Description="打包当前 PCL Living Fork，以便没有启动器的玩家安装整合包"
                                DefaultChecked="True" />
                            </CheckBox.Tag>
                        </CheckBox>
                        <UniformGrid Columns="2" Margin="30,0,0,0"
                                Visibility="{Binding IsChecked, ElementName=CheckOptionsPcl, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsPclCustom">
                                <CheckBox.Tag>
                                    <local:ExportOption 
                                Title="PCL 个性化内容"
                                Description="功能隐藏设置、主页、背景音乐和图片等"
                                DefaultChecked="True" />
                                </CheckBox.Tag>
                            </CheckBox>
                            <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckOptionsModpackMode" IsChecked="True">
                                <CheckBox.Tag>
                                    <local:ExportOption Title="PCL Living Fork 整合包模式"
                                        Description="精简导航与设置，隐藏版本选择；可在启动器设置中关闭"
                                        DefaultChecked="True" />
                                </CheckBox.Tag>
                            </CheckBox>
                        </UniformGrid>
                    </StackPanel>
                    </StackPanel>
                </glass:GlassSurface>
                <glass:GlassSurface Margin="0,0,0,15" Padding="18,14" CornerRadius="14" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                    <Expander x:Name="CardAdvanced" Header="高级选项" Style="{DynamicResource GlassPresentationExpander}">
                    <StackPanel>
                    <StackPanel x:Name="PanAdvancedStandard" Margin="0,8,0,0">
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" Content="开启该版本的版本隔离" x:Name="CheckAdvancedVersionIsolation" IsChecked="True"
                                          ToolTip="导入后，该版本的 Mod、存档等使用独立目录。取消勾选后使用共享游戏目录，不改变全局默认隔离设置。" />
                        <Border Margin="0,2,0,8" Visibility="{Binding IsChecked, ElementName=CheckAdvancedInclude, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource GlassPresentationWarnFill}" BorderBrush="{DynamicResource GlassPresentationWarnEdge}" CornerRadius="8" BorderThickness="0.7" Padding="10,7"><TextBlock Text="建议仅在无法稳定连接 CurseForge 或 Modrinth 时才打包资源文件。&#xa;请不要公开发布含资源文件的整合包，这会违反部分 Mod 的使用协议！" Foreground="{DynamicResource GlassPresentationWarnText}" /></Border>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" Content="打包资源文件，以避免在导入时下载" x:Name="CheckAdvancedInclude"
                                          ToolTip="将 Mod、资源包、光影包的文件直接放入整合包中，这样在导入时就无需联网下载它们。&#xa;建议仅在无法稳定连接 CurseForge 或 Modrinth 时才考虑勾选。" />
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" Content="仅从 Modrinth 下载资源文件" x:Name="CheckAdvancedModrinth"
                                          ToolTip="若资源未在 Modrinth 上托管，则将其原始文件直接放入整合包中。&#xa;如果你想将整合包上传到 Modrinth，这能帮助你分辨哪些文件未在 Modrinth 上托管。" />
                        <Border x:Name="HintModrinthFormat" Margin="26,2,0,2" Background="{DynamicResource GlassPresentationWarnFill}" BorderBrush="{DynamicResource GlassPresentationWarnEdge}" CornerRadius="8" BorderThickness="0.7" Padding="10,7"><TextBlock Text="若不勾选 “PCL 启动器程序”，导出时才能在 “保存类型” 中选择 .mrpack 格式！" Foreground="{DynamicResource GlassPresentationWarnText}" /></Border>
                        <Border Margin="0,20,0,2" x:Name="HintExportConfiguration" Background="{DynamicResource GlassPresentationField}" BorderBrush="{DynamicResource GlassPresentationEdge}" CornerRadius="8" BorderThickness="0.7" Padding="10,7"><TextBlock Text="配置文件中含有更多高级选项，例如精准控制导出的文件、设置整合包存放位置等。&#xa;要修改这些选项，请先点击 “保存配置”，在编辑配置文件后再导入。" Foreground="{DynamicResource GlassPresentationText}" /></Border>
                        <Grid Height="35" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{DynamicResource GlassPresentationButton}" Grid.Column="0" x:Name="BtnAdvancedImport" MinWidth="140" Content="读取配置" Padding="13,0" Margin="0,0,20,0" />
                            <Button Style="{DynamicResource GlassPresentationButton}" Grid.Column="1" x:Name="BtnAdvancedExport" MinWidth="140" Content="保存配置" Padding="13,0" Margin="0,0,20,0" />
                            <Button Style="{DynamicResource GlassPresentationButton}" Grid.Column="2" MinWidth="140" Content="整合包制作指南" Padding="13,0" Margin="0,0,20,0" x:Name="BtnAdvancedHelp"
                                            local:CustomEventService.EventType="打开帮助" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PanMmcPortability" Margin="0,12,0,16" Visibility="Collapsed">
                        <glass:GlassSurface x:Name="MmcJavaNotice" BlurRadius="24" Margin="0,0,0,10" Background="{DynamicResource GlassPresentationField}" BorderBrush="{DynamicResource GlassPresentationEdge}" CornerRadius="8" BorderThickness="0.7" Padding="10,7"><TextBlock Text="本机 Java 路径和自动内存不能直接用于其他电脑。需要转换时，请明确选择下面的处理方式；组件声明的 Java 版本要求会随包保留。" Foreground="{DynamicResource GlassPresentationText}" /></glass:GlassSurface>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckMmcPortableJava" Content="移除本机 Java 选择，保留整合包的 Java 要求" />
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckMmcFixedMemory" Content="将自动内存改为下方固定值（MiB）" />
                        <StackPanel Orientation="Horizontal" Margin="24,6,0,10" IsEnabled="{Binding IsChecked, ElementName=CheckMmcFixedMemory}">
                            <TextBlock Text="最小" VerticalAlignment="Center" />
                            <glass:GlassValidatedTextBox Style="{DynamicResource GlassPresentationTextBox}" x:Name="TextMmcMinimumMemory" Text="0" Width="90" Margin="8,0,20,0" />
                            <TextBlock Text="最大" VerticalAlignment="Center" />
                            <glass:GlassValidatedTextBox Style="{DynamicResource GlassPresentationTextBox}" x:Name="TextMmcMaximumMemory" Text="4096" Width="90" Margin="8,0,0,0" />
                        </StackPanel>
                        <CheckBox Style="{DynamicResource GlassPresentationCheckBox}" x:Name="CheckMmcExcludeInactive" Content="不导出未启用的另一游戏目录" />
                        <glass:GlassSurface x:Name="MmcInactiveNotice" BlurRadius="24" Margin="0,8,0,0" Background="{DynamicResource GlassPresentationWarnFill}" BorderBrush="{DynamicResource GlassPresentationWarnEdge}" CornerRadius="8" BorderThickness="0.7" Padding="10,7"><TextBlock Text="如果另一游戏目录中有文件，需要明确选择排除后才能导出。模组自己的配置可能含个人信息，请在分享前核对。" Foreground="{DynamicResource GlassPresentationWarnText}" /></glass:GlassSurface>
                    </StackPanel>
                    </StackPanel>
                </Expander>
                </glass:GlassSurface>
            </StackPanel>
        </ScrollViewer>
        <Button Style="{DynamicResource GlassPresentationAccentButton}" MinWidth="145" Height="40" Margin="0,0,0,12" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            x:Name="BtnExport" Content="开始导出" />
    </Grid>
</local:GlassWorkspacePage>
