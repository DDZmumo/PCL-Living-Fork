<local:MyPageRight x:Class="PCL.PageInstanceResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack" AllowDrop="True">
    <Grid>
        <Grid x:Name="PanAllBack">
        <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,10" x:Name="PanMain" Grid.IsSharedSizeScope="True">
                <local:MyIconTextButton x:Name="BtnRecycleBack" Text="返回资源" HorizontalAlignment="Left" Margin="-5,5,0,0" Visibility="Collapsed"
                    ToolTip="返回当前版本的资源列表" LogoScale="0.87"
                    Logo="M1097 584 250 584 562 896C591 925 591 972 562 1001 533 1030 487 1030 458 1001L21 565C6 550-0 531 0 511L0 511 0 511C-0 492 6 472 21 457L458 21C487-7 533-7 562 21 591 50 591 97 562 126L250 438 1097 438C1137 438 1170 471 1170 511 1170 551 1137 584 1097 584L1097 584Z" />
                <local:WorldBackupSettings x:Name="BackupSettings" Visibility="Collapsed" Margin="0,15,0,0" />
                <TextBlock x:Name="LabBackupStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="5,10,5,0" Foreground="{DynamicResource ColorBrushGray4}" />
                <local:MySearchBox x:Name="SearchBox" Margin="0,15" HintText="搜索资源名称或说明" />
                <local:MyCard Margin="0,0,0,15" x:Name="CardManage">
                    <Grid x:Name="PanManageButtons" Margin="15,15,0,15" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnOpenFolder" Grid.Column="0" Text="打开文件夹" ColorType="Highlight" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                        <local:MyButton x:Name="BtnImportFile" Grid.Column="1" Text="从文件安装" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" ToolTip="选择本地资源文件安装，也可将文件或资源文件夹拖入列表。" />
                        <local:MyButton x:Name="BtnDownload" Grid.Column="2" Text="下载新资源" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" Visibility="Collapsed" />
                        <local:MyButton x:Name="BtnSelectAll" Grid.Column="3" Text="全选" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                        <local:MyButton x:Name="BtnBackupAll" Grid.Column="4" Text="立即备份" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" Visibility="Collapsed" />
                        <local:MyButton x:Name="BtnRestore" Grid.Column="5" Text="回收站" MinWidth="100" Padding="10,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                    </Grid>
                </local:MyCard>
                <StackPanel x:Name="PanOperations" Margin="20,0,20,12" Visibility="Collapsed">
                        <local:MyTextButton x:Name="BtnUp" Text="返回上级目录" HorizontalAlignment="Left" Margin="5,7,0,3" Visibility="Collapsed" />
                        <TextBlock x:Name="LabOperation" Margin="5,5,5,3" Opacity="0.6" TextWrapping="Wrap" Visibility="Collapsed" />
                        <local:MyButton x:Name="BtnCancel" Text="取消操作" Height="30" Width="100" HorizontalAlignment="Left" Margin="5,5,0,0" Visibility="Collapsed" />
                </StackPanel>
                <local:MyCard x:Name="CardList" Title=" " Margin="0,0,0,14" MinHeight="55" VerticalAlignment="Top">
                  <StackPanel>
                    <DockPanel x:Name="PanSortHeader" Margin="15,13,15,0" LastChildFill="True">
                      <local:MyIconTextButton x:Name="BtnSort" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,2,0,0" Click="SortClick" />
                      <StackPanel x:Name="PanFilter" Orientation="Horizontal" VerticalAlignment="Top" MinHeight="28">
                        <local:MyRadioButton x:Name="BtnFilterAll" Tag="0" ColorType="Highlight" Text="全部" Checked="True" Margin="2,0" VerticalAlignment="Center" />
                        <local:MyRadioButton x:Name="BtnFilterUpdates" Tag="1" ColorType="Highlight" Text="可更新" Margin="2,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <local:MyRadioButton x:Name="BtnFilterFiles" Tag="2" ColorType="Highlight" Text="文件" Margin="2,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <local:MyRadioButton x:Name="BtnFilterFolders" Tag="3" ColorType="Highlight" Text="文件夹" Margin="2,0" VerticalAlignment="Center" Visibility="Collapsed" />
                      </StackPanel>
                    </DockPanel>
                    <StackPanel x:Name="PanResourceList" Margin="20,7,18,22">
                        <TextBlock x:Name="LabEmpty" Text="此目录中暂无资源，可从本地文件安装。" Margin="5,2,5,8" Opacity="0.6" TextWrapping="Wrap" />
                        <StackPanel x:Name="PanList" />
                        <StackPanel x:Name="PanWorlds" Visibility="Collapsed" />
                        <UniformGrid x:Name="PanScreenshots" Columns="2" Visibility="Collapsed" Margin="-5,0,-5,0" />
                    </StackPanel>
                  </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Visibility="Collapsed">
            <StackPanel Margin="20,17">
                <TextBlock x:Name="LabEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center" FontSize="19" Foreground="{DynamicResource ColorBrush3}" UseLayoutRounding="True" SnapsToDevicePixels="True" />
                <Rectangle Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock x:Name="LabEmptyHint" Margin="10,10,10,0" TextWrapping="Wrap" />
                <Grid Margin="15,20,0,5" Height="35" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:MyButton x:Name="BtnHintDownload" Grid.Column="0" Text="下载资源" MinWidth="140" Margin="0,0,17,0" Padding="13,0" ColorType="Highlight" />
                    <local:MyButton x:Name="BtnHintInstall" Grid.Column="1" Text="从文件安装" MinWidth="140" Margin="0,0,17,0" Padding="13,0" />
                    <local:MyButton x:Name="BtnHintOpen" Grid.Column="2" Text="打开文件夹" MinWidth="140" Margin="0,0,17,0" Padding="13,0" />
                </Grid>
                <local:MyTextButton x:Name="BtnHintRestore" Text="回收站" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>
        </local:MyCard>
        </Grid>
        <local:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" UseAnimation="False">
            <local:MyLoading x:Name="Load" Text="正在读取游戏资源" Margin="20,20,20,17" />
        </local:MyCard>
        <local:MyCard x:Name="CardSelect" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="25,25,25,0" UseAnimation="False">
            <local:MyCard.RenderTransform>
                <TranslateTransform x:Name="TransSelect" Y="-10" />
            </local:MyCard.RenderTransform>
            <TextBlock x:Name="LabSelect" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="9" Foreground="{DynamicResource ColorBrush2}" />
            <StackPanel Orientation="Horizontal" Margin="5,28,5,5">
                <local:MyIconTextButton x:Name="BtnUpdate" Text="更新" Visibility="Collapsed" />
                <local:MyIconTextButton x:Name="BtnBackupRestore" Text="恢复备份" Visibility="Collapsed" />
                <local:MyIconTextButton x:Name="BtnExport" Text="导出" />
                <local:MyIconTextButton x:Name="BtnDelete" Text="删除" />
                <local:MyIconTextButton x:Name="BtnDeselect" Text="取消选择" />
            </StackPanel>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
