<local:GlassWorkspacePage x:Class="PCL.PageSetupModpack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core">
    <ScrollViewer x:Name="PanBack" Style="{DynamicResource GlassPresentationScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:GlassSettingGroup x:Name="CardLauncher" Title="启动器" Margin="0,15,0,22">
                <local:GlassSettingItem Title="启动器版本" Description="当前运行的启动器版本。">
                    <TextBlock x:Name="LabVersion" FontWeight="SemiBold" />
                </local:GlassSettingItem>
                <local:GlassSettingItem Title="缓存文件夹" Description="下载、皮肤等缓存文件的位置。留空使用默认值，重启启动器后生效。">
                    <glass:GlassValidatedTextBox Style="{DynamicResource GlassPresentationTextBox}" x:Name="TextSystemCache" local:SettingService.Key="SystemSystemCache">
                        <glass:GlassValidatedTextBox.ValidateRules><local:ValidateNullable /><local:ValidateFolderPath UseMinecraftCharCheck="False" /></glass:GlassValidatedTextBox.ValidateRules>
                    </glass:GlassValidatedTextBox>
                </local:GlassSettingItem>
                <local:GlassSettingItem Title="整合包模式" Description="只显示当前整合包的实例和相关设置。">
                    <CheckBox Style="{DynamicResource GlassPresentationSwitch}" x:Name="CheckModpackMode" />
                </local:GlassSettingItem>
            </local:GlassSettingGroup>
        </StackPanel>
    </ScrollViewer>
</local:GlassWorkspacePage>
