<local:GlassWorkspacePage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core" x:Class="PCL.PageSetupPersonal">
    <Grid>
    <ScrollViewer x:Name="PanBack" Style="{DynamicResource GlassPresentationScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,10">
            <!-- Lead card: whether sync is on, what the shared profile holds, and the actions on it. -->
            <local:GlassHeroCard Title="个人游戏设置同步"
                Icon="M2,5 H6 V3 H8 V9 H6 V7 H2 Z M10,5 H22 V7 H10 Z M2,11 H14 V9 H16 V15 H14 V13 H2 Z M18,11 H22 V13 H18 Z M2,17 H4 V15 H6 V21 H4 V19 H2 Z M8,17 H22 V19 H8 Z">
                <local:GlassHeroCard.Status>
                    <StackPanel>
                        <Border x:Name="HintStatus" Background="Transparent">
                            <TextBlock x:Name="LabStatus" Text="跟随主界面当前选择的游戏版本。" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource GlassPresentationSecondary}" />
                        </Border>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock x:Name="LabSummary" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource GlassPresentationText}" Margin="0,0,12,0" />
                            <TextBlock x:Name="LabUpdated" FontSize="12.5" Foreground="{DynamicResource GlassPresentationSecondary}" Visibility="Collapsed" />
                        </WrapPanel>
                    </StackPanel>
                </local:GlassHeroCard.Status>
                <local:GlassHeroCard.Actions>
                    <CheckBox Style="{DynamicResource GlassPresentationSwitch}" x:Name="CheckEnabled"
                              ToolTip="只同步各版本通用的基础个人设置，且目标版本必须已有对应项目。未选中的设置和模组配置保持原样。" />
                </local:GlassHeroCard.Actions>
                <local:GlassHeroCard.Footer>
                    <StackPanel>
                        <TextBlock x:Name="LabEditScope" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource GlassPresentationSecondary}" Margin="0,0,0,10" Visibility="Collapsed" />
                        <WrapPanel>
                            <Button Style="{DynamicResource GlassPresentationAccentButton}" x:Name="BtnImport" Content="从当前版本导入全局设置" Margin="0,0,8,6" />
                            <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnSaveGlobal" Content="保存全局设置" Margin="0,0,8,6" />
                            <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnApply" Content="保存此版本个人设置" Margin="0,0,8,6" />
                            <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnWriteBack" Content="回写到全局" Margin="0,0,8,6" Visibility="Collapsed" />
                            <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnSyncFromGlobal" Content="从全局同步" Margin="0,0,8,6" Visibility="Collapsed" />
                            <Button Style="{DynamicResource GlassPresentationButton}" x:Name="BtnRefresh" Content="放弃修改" Margin="0,0,8,6" />
                        </WrapPanel>
                    </StackPanel>
                </local:GlassHeroCard.Footer>
            </local:GlassHeroCard>
            <local:GlassSettingGroup Title="版本">
                <local:GlassSettingItem Description="同步作用的游戏版本。">
                    <local:GlassSettingItem.TitleContent><TextBlock x:Name="LabInstanceCaption" Text="当前游戏版本" /></local:GlassSettingItem.TitleContent>
                    <TextBlock x:Name="LabInstance" Text="尚未选择游戏版本" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" TextAlignment="Right" />
                </local:GlassSettingItem>
                <local:GlassSettingItem Description="全局方案最近一次是从哪个版本导入的。">
                    <local:GlassSettingItem.TitleContent><TextBlock x:Name="LabImportedInstanceCaption" Text="目前导入来源版本" /></local:GlassSettingItem.TitleContent>
                    <TextBlock x:Name="LabImportedInstance" TextTrimming="CharacterEllipsis" MaxWidth="320" TextAlignment="Right" />
                </local:GlassSettingItem>
                <local:GlassSettingItem Description="关闭同步后，这个版本保留自己的按键、鼠标、视野等设置。">
                    <local:GlassSettingItem.TitleContent><TextBlock x:Name="LabPolicyCaption" Text="此版本策略" /></local:GlassSettingItem.TitleContent>
                    <ComboBox Style="{DynamicResource GlassPresentationComboBox}" x:Name="ComboPolicy">
                        <ComboBoxItem Content="跟随全局设置"/>
                        <ComboBoxItem Content="不同步，保留此版本的个人设置"/>
                    </ComboBox>
                </local:GlassSettingItem>
            </local:GlassSettingGroup>
            <glass:GlassSurface x:Name="CardConflicts" Visibility="Collapsed" Margin="0,0,0,15" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                <StackPanel>
                    <TextBlock Text="待处理的同步冲突" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <StackPanel x:Name="PanConflicts" />
                </StackPanel>
            </glass:GlassSurface>
            <glass:GlassSurface x:Name="CardSearch" Margin="0,0,0,15" Padding="{DynamicResource GlassCardSettingsPadding}" CornerRadius="{DynamicResource GlassCardSettingsRadius}" Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="0.7" BlurRadius="24" TintOpacity="1" HighlightOpacity="0">
                <StackPanel>
                    <TextBlock Text="选择同步项目" x:Name="LabSearchTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid x:Name="SearchHost"><TextBox x:Name="TextSearch" Style="{DynamicResource GlassPresentationTextBox}" Height="36" /></Grid>
                </StackPanel>
            </glass:GlassSurface>
            <StackPanel x:Name="PanGroups"/>
        </StackPanel>
    </ScrollViewer>
        <local:GlassSelectionDock x:Name="CardCapture" />
    </Grid>
</local:GlassWorkspacePage>
