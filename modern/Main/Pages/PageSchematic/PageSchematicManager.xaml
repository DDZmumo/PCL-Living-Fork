<local:MyPageRight x:Class="PCL.PageSchematicManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMain" Margin="25,30,25,10">
                <local:MyCard x:Name="CardInstance" Margin="0,0,0,15">
                    <Grid Height="52" Margin="14,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource ColorBrushGray6}" VerticalAlignment="Center">
                            <TextBlock Text="▦" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LabInstName" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LabInstPath" FontSize="11" Margin="0,2,0,0" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </local:MyCard>
                <local:MySearchBox x:Name="SearchBox" Margin="0,0,0,15" HintText="搜索投影文件" />
                <local:MyCard Margin="0,0,0,15" Title="快捷操作">
                    <Grid Height="35" Margin="25,40,15,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnOpenFolder" Grid.Column="0" Text="打开文件夹" MinWidth="140" Padding="13,0" Margin="0,0,20,0" HorizontalAlignment="Left" />
                        <local:MyButton x:Name="BtnRefresh" Grid.Column="1" Text="刷新列表" MinWidth="140" Padding="13,0" HorizontalAlignment="Left" />
                    </Grid>
                </local:MyCard>
                <local:MyCard x:Name="CardList" Margin="0,0,0,14" MinHeight="55" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="15,13,15,0">
                            <TextBlock x:Name="LabCount" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <local:MyIconTextButton x:Name="BtnSort" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,2,0,0" />
                        </Grid>
                        <StackPanel x:Name="PanList" Margin="20,14,18,22">
                            <TextBlock x:Name="LabEmpty" Text="还没有投影文件。把 .litematic / .schem / .nbt 放进实例的 schematics 文件夹后再刷新。" Margin="0,0,0,8" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
        <Grid x:Name="PanPreview" Visibility="Collapsed" Margin="0" />
    </Grid>
</local:MyPageRight>
