<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
    <Style TargetType="{x:Type local:LauncherMarkupIconTextButton}">
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="MaxHeight" Value="27" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LauncherMarkupIconTextButton}">
                    <Border CornerRadius="13.5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="ColorType" Value="Highlight"><Setter Property="Foreground" Value="{DynamicResource GlassPresentationAccent}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlassPresentationAccent}" />
                <Setter Property="Background" Value="{DynamicResource GlassPresentationHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource GlassPresentationPressed}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource GlassPresentationSecondary}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type local:LauncherMarkupTextButton}">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
            </Border></ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource GlassPresentationAccent}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type local:LauncherMarkupListItem}">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button"><Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
            </Border></ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource GlassPresentationHover}" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
