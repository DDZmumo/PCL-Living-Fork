<UserControl x:Class="PCLLF.Wpf.Glass.GlassLauncherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core"
    xmlns:motion="clr-namespace:PCLLF.Wpf.Motion;assembly=PCLLF.WPF.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
    Background="Transparent" Foreground="{DynamicResource GlassTextBrush}"
    FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI" FontSize="14"
    SnapsToDevicePixels="True" UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display" Focusable="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="GlassTextBrush" Color="#F4FFFFFF" />
        <SolidColorBrush x:Key="GlassSecondaryTextBrush" Color="#BFFFFFFF" />
        <SolidColorBrush x:Key="GlassMainBrush" Color="#54343B3C" />
        <SolidColorBrush x:Key="GlassCardBrush" Color="#66444847" />
        <SolidColorBrush x:Key="GlassChromeBrush" Color="#78575F5D" />
        <SolidColorBrush x:Key="GlassOutlineBrush" Color="#50FFFFFF" />
        <SolidColorBrush x:Key="GlassControlBrush" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="GlassHoverBrush" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="GlassSelectedBrush" Color="#32FFFFFF" />
        <SolidColorBrush x:Key="GlassCheckOutlineBrush" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="GlassAccentBrush" Color="#F4FFFFFF" />
        <SolidColorBrush x:Key="GlassAccentTextBrush" Color="#FF303B3C" />

        <Geometry x:Key="IconPlay">M 7,4 L 19,12 7,20 Z</Geometry>
        <Geometry x:Key="IconDownload">M12,3 V15 M7,10 L12,15 17,10 M4,16 V20 H20 V16</Geometry>
        <Geometry x:Key="IconHeart">M12,20 C9,17 3,13 3,8 C3,3 9,2 12,7 C15,2 21,3 21,8 C21,13 15,17 12,20 Z</Geometry>
        <Geometry x:Key="IconSettings">M9,3 L15,3 16,6 19,7 21,10 19,12 21,15 19,18 16,18 14,21 10,21 8,18 5,18 3,15 5,12 3,9 5,6 8,6 Z M15.5,12 A3.5,3.5 0 1 1 8.5,12 A3.5,3.5 0 1 1 15.5,12</Geometry>
        <Geometry x:Key="IconMore">M5,12 A1,1 0 1 1 3,12 A1,1 0 1 1 5,12 M13,12 A1,1 0 1 1 11,12 A1,1 0 1 1 13,12 M21,12 A1,1 0 1 1 19,12 A1,1 0 1 1 21,12</Geometry>
        <Geometry x:Key="IconGrid">M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z</Geometry>
        <Geometry x:Key="IconPlus">M12,4 V20 M4,12 H20</Geometry>
        <Geometry x:Key="IconClose">M5,5 L19,19 M19,5 L5,19</Geometry>
        <Geometry x:Key="IconBack">M15,5 L8,12 15,19</Geometry>
        <Geometry x:Key="IconAccount">M16.5,7 A4.5,4.5 0 1 1 7.5,7 A4.5,4.5 0 1 1 16.5,7 M4,22 V20 C4,12 20,12 20,20 V22</Geometry>
        <Geometry x:Key="IconWallpaper">M4,3 H20 A1,1 0 0 1 21,4 V20 A1,1 0 0 1 20,21 H4 A1,1 0 0 1 3,20 V4 A1,1 0 0 1 4,3 M3,17 L9,11 14,16 17,13 21,17 M17,7 A1,1 0 1 1 15,7 A1,1 0 1 1 17,7</Geometry>
        <Geometry x:Key="IconWorld">M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 M3,12 H21 M12,3 C6,8 6,16 12,21 C18,16 18,8 12,3</Geometry>

        <Style x:Key="GlassText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI" />
        </Style>

        <Style x:Key="GlassFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="2" BorderBrush="{DynamicResource GlassTextBrush}" BorderThickness="1.5" CornerRadius="18" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource GlassControlBrush}" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="0.7" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisual}" />
            <Setter Property="motion:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource GlassHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource GlassSelectedBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassCircleButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="GlassLaunchButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LaunchBorder" CornerRadius="24" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LaunchBorder" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="LaunchBorder" Property="Opacity" Value="0.76" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassNavButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Height" Value="42" /><Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="GlassPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.55" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="17" /><Setter Property="Height" Value="17" />
        </Style>
        <Style x:Key="GlassCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="38" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="20" Height="20" CornerRadius="5" Background="#13FFFFFF" BorderBrush="{DynamicResource GlassCheckOutlineBrush}" BorderThickness="1.1" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M4,9 L7,12 14,5" Stroke="{DynamicResource GlassTextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Hidden" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /><Setter TargetName="CheckBorder" Property="Background" Value="#26FFFFFF" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource GlassTextBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ShellRoot" Background="Transparent" MouseLeftButtonDown="ShellRoot_MouseLeftButtonDown">
        <Image x:Name="WallpaperImage" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed">
            <Image.Clip><RectangleGeometry x:Name="WallpaperClip" RadiusX="36" RadiusY="36" /></Image.Clip>
        </Image>

        <glass:GlassSurface x:Name="MainSurface" Margin="96,104,26,26" CornerRadius="36" Padding="26"
            Background="{DynamicResource GlassMainBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="0.8" BlurRadius="26">
            <Grid x:Name="MainContentGrid">
                <Grid x:Name="HomePanel">
                    <Canvas x:Name="HomeDeck" SizeChanged="HomeDeck_SizeChanged" ClipToBounds="False">
                        <glass:GlassSurface x:Name="PrimaryCard" Width="326" Height="348" CornerRadius="16"
                            Background="{DynamicResource GlassCardBrush}" BorderBrush="#38FFFFFF" BorderThickness="0.7" BlurRadius="22">
                            <glass:GlassSurface.RenderTransform><TranslateTransform x:Name="PrimaryTranslation" /></glass:GlassSurface.RenderTransform>
                            <Grid Margin="16">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                                <StackPanel x:Name="InstanceCenter" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,16,16,12">
                                    <Image x:Name="InstanceImage" Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Style="{StaticResource GlassText}" x:Name="InstanceNameText" Text="选择实例" FontSize="23" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,13,0,0" />
                                    <TextBlock Style="{StaticResource GlassText}" x:Name="InstanceDescriptionText" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,4,0,0" />
                                    <Button x:Name="LaunchButton" Height="44" MinWidth="188" Margin="0,20,0,0" Padding="25,0" Style="{StaticResource GlassLaunchButton}"
                                        Click="LaunchButton_Click" AutomationProperties.Name="启动游戏" Background="{DynamicResource GlassAccentBrush}" Foreground="{DynamicResource GlassAccentTextBrush}" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="LaunchGlyph" Data="{StaticResource IconPlay}" Fill="{Binding Foreground, ElementName=LaunchButton}" Width="13" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                            <TextBlock Style="{StaticResource GlassText}" x:Name="LaunchButtonText" Text="启动游戏" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource GlassText}" x:Name="LaunchStatusText" FontSize="11" Foreground="{DynamicResource GlassSecondaryTextBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="240" Margin="0,8,0,0" Visibility="Collapsed" />
                                    <ProgressBar x:Name="LaunchProgressBar" Height="2" Maximum="1" MinWidth="168" Margin="6,8,6,0" Foreground="{DynamicResource GlassTextBrush}" Background="#18FFFFFF" BorderThickness="0" Visibility="Collapsed" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Button Style="{StaticResource GlassCircleButton}" HorizontalAlignment="Left" Click="SelectInstanceButton_Click" ToolTip="选择实例" AutomationProperties.Name="选择实例">
                                        <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconGrid}" Width="16" Height="16" />
                                    </Button>
                                    <Button x:Name="InstanceSettingsButton" Style="{StaticResource GlassCircleButton}" HorizontalAlignment="Right" Click="InstanceSettingsButton_Click" ToolTip="实例设置" AutomationProperties.Name="实例设置">
                                        <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconSettings}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </glass:GlassSurface>

                        <Grid x:Name="AuxiliaryCards" Width="286" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                            <Grid.RenderTransform><TranslateTransform x:Name="AuxiliaryTranslation" /></Grid.RenderTransform>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <glass:GlassSurface x:Name="DependencyCard" CornerRadius="16" Padding="18,14" MinHeight="108"
                                Background="{DynamicResource GlassCardBrush}" BorderBrush="#38FFFFFF" BorderThickness="0.7" BlurRadius="22">
                                <StackPanel>
                                    <CheckBox x:Name="DependencyCheckBox" Style="{StaticResource GlassCheckBox}" Content="启动时检查模组依赖" Checked="DependencyCheckBox_Changed" Unchecked="DependencyCheckBox_Changed" AutomationProperties.Name="启动时检查模组依赖" />
                                    <CheckBox x:Name="AutoFillCheckBox" Style="{StaticResource GlassCheckBox}" Content="自动补全模组依赖" Checked="AutoFillCheckBox_Changed" Unchecked="AutoFillCheckBox_Changed" AutomationProperties.Name="自动补全模组依赖" />
                                </StackPanel>
                            </glass:GlassSurface>
                            <glass:GlassSurface x:Name="RecentWorldCard" Grid.Row="2" CornerRadius="16" Padding="18,16" MinHeight="121"
                                Background="{DynamicResource GlassCardBrush}" BorderBrush="#38FFFFFF" BorderThickness="0.7" BlurRadius="22">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource GlassText}" Text="上次游玩" FontWeight="SemiBold" FontSize="13" />
                                    <Button x:Name="RecentWorldButton" Grid.Row="1" Margin="-6,10,-6,-4" Padding="6" Style="{StaticResource GlassButton}" Background="Transparent" BorderThickness="0" Click="RecentWorldButton_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="继续上次游玩的世界">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border CornerRadius="8" Background="#16FFFFFF" Width="42" Height="42" ClipToBounds="True">
                                                <Grid>
                                                    <Path x:Name="WorldFallbackGlyph" Data="{StaticResource IconWorld}" Stroke="{DynamicResource GlassSecondaryTextBrush}" StrokeThickness="1.3" Stretch="Uniform" Margin="10" />
                                                    <Image x:Name="RecentWorldImage" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,42,42" RadiusX="8" RadiusY="8" /></Image.Clip></Image>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Style="{StaticResource GlassText}" x:Name="RecentWorldNameText" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource GlassText}" x:Name="RecentWorldDetailText" FontSize="11" Foreground="{DynamicResource GlassSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <TextBlock Style="{StaticResource GlassText}" x:Name="NoRecentWorldText" Grid.Row="1" Text="暂无最近游玩的世界" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,15,0,0" />
                                </Grid>
                            </glass:GlassSurface>
                        </Grid>

                        <Grid x:Name="ExpandButtonContainer" Width="36" Height="36">
                            <Grid.RenderTransform><TranslateTransform x:Name="ExpandTranslation" /></Grid.RenderTransform>
                            <Button x:Name="ExpandButton" Style="{StaticResource GlassCircleButton}" Width="36" Height="36" Padding="10" Click="ExpandButton_Click" ToolTip="更多启动选项" AutomationProperties.Name="展开启动选项" AutomationProperties.HelpText="显示依赖检查和上次游玩的世界">
                                <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconPlus}" Width="13" Height="13" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform x:Name="ExpandRotation" /></Path.RenderTransform>
                                </Path>
                            </Button>
                        </Grid>
                    </Canvas>
                    <Button x:Name="WallpaperButton" Style="{StaticResource GlassCircleButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-8" Background="Transparent" BorderThickness="0" Click="WallpaperButton_Click" ToolTip="更换背景" AutomationProperties.Name="更换启动器背景">
                        <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconWallpaper}" Width="16" Height="16" Opacity="0.7" />
                    </Button>
                </Grid>
                <ContentControl x:Name="PageContent" Visibility="Hidden" IsHitTestVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </glass:GlassSurface>

        <glass:GlassSurface x:Name="SideRail" Width="56" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,104,0,26"
            CornerRadius="28" Padding="5" Background="{DynamicResource GlassChromeBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="0.8" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
            <glass:GlassSurface.RenderTransform><TranslateTransform x:Name="RailTranslation" X="60" /></glass:GlassSurface.RenderTransform>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="SidebarScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False">
                    <StackPanel x:Name="SidebarPanel" />
                </ScrollViewer>
                <Button x:Name="NavigationMenuButton" Grid.Row="1" Style="{StaticResource GlassCircleButton}" Width="44" Height="44" Padding="13" Margin="0,3,0,0" Visibility="Collapsed"
                    Click="NavigationMenuButton_Click" ToolTip="全部页面选项" AutomationProperties.Name="展开全部页面选项">
                    <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconMore}" Width="18" Height="3" />
                </Button>
            </Grid>
        </glass:GlassSurface>

        <Grid x:Name="Header" Height="56" VerticalAlignment="Top" Margin="166,24,96,0">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="AccountColumn" Width="168" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
            <glass:GlassSurface x:Name="AccountSurface" CornerRadius="28" Background="{DynamicResource GlassChromeBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="0.8" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <Button x:Name="AccountButton" Style="{StaticResource GlassNavButton}" Height="54" Padding="10,0,14,0" HorizontalContentAlignment="Stretch" Click="AccountButton_Click" AutomationProperties.Name="当前账户">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="#24FFFFFF" ClipToBounds="True">
                            <Grid>
                                <Path x:Name="AccountFallbackGlyph" Data="{StaticResource IconAccount}" Stroke="{DynamicResource GlassTextBrush}" StrokeThickness="1.25" Stretch="Uniform" Margin="8,7" />
                                <Image x:Name="AccountAvatarImage" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" /></Image.Clip></Image>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource GlassText}" x:Name="AccountNameText" Grid.Column="1" Text="未登录" FontSize="13" VerticalAlignment="Center" Margin="9,0,7,0" TextTrimming="CharacterEllipsis" />
                        <Path Grid.Column="2" Data="M2,4 L6,8 10,4" Stroke="{DynamicResource GlassSecondaryTextBrush}" StrokeThickness="1.25" Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </glass:GlassSurface>

            <glass:GlassSurface x:Name="NavigationSurface" Grid.Column="2" MaxWidth="560" CornerRadius="28" Padding="6" Background="{DynamicResource GlassChromeBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="0.8" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <Grid>
                    <Grid x:Name="NavigationButtons" SizeChanged="NavigationButtons_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border x:Name="NavSelection" Width="82" Height="42" HorizontalAlignment="Left" CornerRadius="21" Background="{DynamicResource GlassSelectedBrush}" BorderBrush="#30FFFFFF" BorderThickness="0.7" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform x:Name="NavigationTranslation" /></Border.RenderTransform>
                        </Border>
                        <Button x:Name="NavLaunch" Grid.Column="0" Style="{StaticResource GlassNavButton}" Tag="0" Click="NavigationButton_Click" AutomationProperties.Name="启动"><TextBlock Style="{StaticResource GlassText}" Text="启动" FontSize="14" /></Button>
                        <Button x:Name="NavDownload" Grid.Column="1" Style="{StaticResource GlassNavButton}" Tag="1" Click="NavigationButton_Click" AutomationProperties.Name="下载"><TextBlock Style="{StaticResource GlassText}" Text="下载" FontSize="14" /></Button>
                        <Button x:Name="NavFavorites" Grid.Column="2" Style="{StaticResource GlassNavButton}" Tag="10" Click="NavigationButton_Click" AutomationProperties.Name="收藏"><TextBlock Style="{StaticResource GlassText}" Text="收藏" FontSize="14" /></Button>
                        <Button x:Name="NavSettings" Grid.Column="3" Style="{StaticResource GlassNavButton}" Tag="3" Click="NavigationButton_Click" AutomationProperties.Name="设置"><TextBlock Style="{StaticResource GlassText}" Text="设置" FontSize="14" /></Button>
                        <Button x:Name="NavOther" Grid.Column="4" Style="{StaticResource GlassNavButton}" Tag="4" Click="NavigationButton_Click" AutomationProperties.Name="更多"><TextBlock Style="{StaticResource GlassText}" Text="更多" FontSize="14" /></Button>
                    </Grid>
                    <Grid x:Name="BackTitlePanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GlassCircleButton}" Width="40" Height="40" Padding="13" Background="Transparent" BorderThickness="0" Click="BackButton_Click" ToolTip="返回" AutomationProperties.Name="返回上一页"><Path Style="{StaticResource GlassPath}" Data="{StaticResource IconBack}" Width="10" Height="17" /></Button>
                        <TextBlock Style="{StaticResource GlassText}" x:Name="PageTitleText" Grid.Column="1" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,18,0" />
                    </Grid>
                </Grid>
            </glass:GlassSurface>

            <glass:GlassSurface x:Name="WindowControlsSurface" Grid.Column="4" CornerRadius="28" Padding="6" Background="{DynamicResource GlassChromeBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="0.8" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GlassNavButton}" Padding="13" Click="MinimizeButton_Click" ToolTip="最小化" AutomationProperties.Name="最小化窗口"><Path Data="M2,8 H16" Style="{StaticResource GlassPath}" Width="13" Height="1" /></Button>
                    <Button Grid.Column="1" Style="{StaticResource GlassNavButton}" Padding="13" Click="CloseButton_Click" ToolTip="关闭" AutomationProperties.Name="关闭窗口"><Path Data="{StaticResource IconClose}" Style="{StaticResource GlassPath}" Width="13" Height="13" /></Button>
                </Grid>
            </glass:GlassSurface>
        </Grid>

        <glass:GlassSurface x:Name="AccountPopover" Width="352" MaxHeight="520" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="166,91,0,26"
            CornerRadius="24" Padding="18" Background="{DynamicResource GlassMainBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="0.8" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource GlassText}" Text="账户" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GlassCircleButton}" Width="36" Height="36" Background="Transparent" BorderThickness="0" Padding="12" Click="CloseAccountButton_Click" AutomationProperties.Name="关闭账户面板"><Path Style="{StaticResource GlassPath}" Data="{StaticResource IconClose}" Width="12" Height="12" /></Button>
                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420" Focusable="False">
                    <ContentControl x:Name="AccountContent" HorizontalContentAlignment="Stretch" />
                </ScrollViewer>
            </Grid>
        </glass:GlassSurface>

        <glass:GlassSurface x:Name="NavigationPopover" Width="288" MaxHeight="520" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="96,104,0,26"
            CornerRadius="24" Padding="16" Background="{DynamicResource GlassMainBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="0.8" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource GlassText}" x:Name="NavigationPopoverTitle" Text="页面选项" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GlassCircleButton}" Width="36" Height="36" Background="Transparent" BorderThickness="0" Padding="12" Click="CloseNavigationButton_Click" AutomationProperties.Name="关闭页面选项"><Path Style="{StaticResource GlassPath}" Data="{StaticResource IconClose}" Width="12" Height="12" /></Button>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ContentControl x:Name="NavigationContent" HorizontalContentAlignment="Stretch" />
                </ScrollViewer>
            </Grid>
        </glass:GlassSurface>
    </Grid>
</UserControl>
