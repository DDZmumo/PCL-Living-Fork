<UserControl x:Class="PCLLF.Wpf.Glass.GlassLauncherView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:PCLLF.Wpf.Motion;assembly=PCLLF.WPF.Core" xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core" xmlns:music="clr-namespace:PCL" xmlns:sys="clr-namespace:System;assembly=System.Runtime" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="{DynamicResource GlassTextBrush}" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="False">
    <UserControl.Resources>
        <sys:Double x:Key="WorkspaceNavRowHeight">52</sys:Double>
        <TranslateTransform x:Key="RailLabelTranslation" />
        <FontFamily x:Key="GlassDisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
        <FontFamily x:Key="GlassBrandFont">Rubik, MiSans, HarmonyOS Sans SC, Segoe UI Variable Display, Bahnschrift, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="GlassListSelectedBrush" Color="#B8B9BBBD" />
        <SolidColorBrush x:Key="HomeTextBrush" Color="White" />
        <SolidColorBrush x:Key="HomeSecondaryTextBrush" Color="#FFDDDDDD" />
        <CornerRadius x:Key="GlassRadiusMain">8</CornerRadius>
        <CornerRadius x:Key="GlassRadiusHero">20</CornerRadius>
        <CornerRadius x:Key="GlassRadiusCard">14</CornerRadius>
        <CornerRadius x:Key="GlassRadiusChrome">10</CornerRadius>
        <CornerRadius x:Key="GlassRadiusPopover">14</CornerRadius>
        <CornerRadius x:Key="GlassRadiusControl">10</CornerRadius>
        <Thickness x:Key="GlassPaddingMain">24</Thickness>
        <Style x:Key="GlassPageTitleFrost" TargetType="glass:GlassSurface">
            <Setter Property="Margin" Value="-14,-6,-16,-6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BlurRadius" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Effect"><Setter.Value><BlurEffect Radius="10" RenderingBias="Performance" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(glass:GlassMaterial.WallpaperSource), RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GlassAccountDeckContent" TargetType="Grid">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Path=(glass:GlassMaterial.WallpaperSource), RelativeSource={RelativeSource Self}}" Value="{x:Null}" />
                        <Condition Binding="{Binding Path=(glass:GlassMaterial.DesktopBackdropEnabled), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Effect"><Setter.Value><BlurEffect Radius="16" RenderingBias="Performance" /></Setter.Value></Setter>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="GlassWindowBrush" Color="#FF181818" />
        <SolidColorBrush x:Key="GlassTextBrush" Color="#FFF4F4F4" />
        <SolidColorBrush x:Key="GlassSecondaryTextBrush" Color="#FFB8B8B8" />
        <SolidColorBrush x:Key="GlassMainBrush" Color="#FF181818" />
        <SolidColorBrush x:Key="GlassSplashBrush" Color="#B8141416" />
        <SolidColorBrush x:Key="GlassCardBrush" Color="#FF202020" />
        <SolidColorBrush x:Key="GlassChromeBrush" Color="#F5202020" />
        <SolidColorBrush x:Key="GlassOutlineBrush" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="GlassControlBrush" Color="#FF333333" />
        <SolidColorBrush x:Key="GlassHoverBrush" Color="#FF414141" />
        <SolidColorBrush x:Key="GlassSelectedBrush" Color="#FF3D3D3D" />
        <SolidColorBrush x:Key="GlassNavHoverBrush" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="GlassNavHoverOutlineBrush" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="GlassAccentBrush" Color="#FFE6E6E6" />
        <SolidColorBrush x:Key="GlassAccentTextBrush" Color="#FF1A1A1A" />
        <Geometry x:Key="IconPlay">M 7,4 L 19,12 7,20 Z</Geometry>
        <Geometry x:Key="IconDownload">M12,3 V15 M7,10 L12,15 17,10 M4,16 V20 H20 V16</Geometry>
        <Geometry x:Key="IconHeart">M12,20 C9,17 3,13 3,8 C3,3 9,2 12,7 C15,2 21,3 21,8 C21,13 15,17 12,20 Z</Geometry>
        <Geometry x:Key="IconSettings">M9,3 L15,3 16,6 19,7 21,10 19,12 21,15 19,18 16,18 14,21 10,21 8,18 5,18 3,15 5,12 3,9 5,6 8,6 Z M15.5,12 A3.5,3.5 0 1 1 8.5,12 A3.5,3.5 0 1 1 15.5,12</Geometry>
        <Geometry x:Key="IconMore">M5,12 A1,1 0 1 1 3,12 A1,1 0 1 1 5,12 M13,12 A1,1 0 1 1 11,12 A1,1 0 1 1 13,12 M21,12 A1,1 0 1 1 19,12 A1,1 0 1 1 21,12</Geometry>
        <Geometry x:Key="IconGrid">M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z</Geometry>
        <Geometry x:Key="IconPlus">M12,4 V20 M4,12 H20</Geometry>
        <Geometry x:Key="IconClose">M5,5 L19,19 M19,5 L5,19</Geometry>
        <Geometry x:Key="IconThemeSun">M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 M12,2 V4 M12,20 V22 M2,12 H4 M20,12 H22 M5,5 L6.5,6.5 M17.5,17.5 L19,19 M5,19 L6.5,17.5 M17.5,6.5 L19,5</Geometry>
        <Geometry x:Key="IconThemeMoon">M20.9,13.3 A9,9 0 1 1 10.7,3.1 A7,7 0 0 0 20.9,13.3 Z</Geometry>
        <Geometry x:Key="IconBack">M15,5 L8,12 15,19</Geometry>
        <Geometry x:Key="IconAccount">M16.5,7 A4.5,4.5 0 1 1 7.5,7 A4.5,4.5 0 1 1 16.5,7 M4,22 V20 C4,12 20,12 20,20 V22</Geometry>
        <Geometry x:Key="IconWallpaper">M4,3 H20 A1,1 0 0 1 21,4 V20 A1,1 0 0 1 20,21 H4 A1,1 0 0 1 3,20 V4 A1,1 0 0 1 4,3 M3,17 L9,11 14,16 17,13 21,17 M17,7 A1,1 0 1 1 15,7 A1,1 0 1 1 17,7</Geometry>
        <Geometry x:Key="IconWorld">M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 M3,12 H21 M12,3 C6,8 6,16 12,21 C18,16 18,8 12,3</Geometry>
        <Style x:Key="GlassText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="GlassPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style x:Key="GlassRailPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.75" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="None" />
        </Style>
        <Style x:Key="GlassFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="2" CornerRadius="8" BorderBrush="{DynamicResource GlassAccentBrush}" BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource GlassControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisual}" />
            <Setter Property="motion:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <!-- State layer: tints whatever fill the button has (neutral, transparent or accent) instead of replacing it. -->
                            <Border x:Name="StateLayer" CornerRadius="8" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.14" />
                                <Setter TargetName="ButtonContent" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassCircleButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="GlassNavButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <EventSetter Event="Loaded" Handler="NavigationButton_Loaded" />
            <EventSetter Event="Unloaded" Handler="NavigationButton_Unloaded" />
            <EventSetter Event="MouseEnter" Handler="NavigationButton_HoverChanged" />
            <EventSetter Event="MouseLeave" Handler="NavigationButton_HoverChanged" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="NavHoverLayer" CornerRadius="8" Background="{DynamicResource GlassNavHoverBrush}" BorderBrush="{DynamicResource GlassNavHoverOutlineBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="NavContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="NavHoverTranslation" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavContent" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassLaunchButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Background" Value="{DynamicResource GlassAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource GlassAccentTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" CornerRadius="12" Background="{TemplateBinding Background}" />
                            <Border x:Name="StateLayer" CornerRadius="12" Background="White" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Background" Value="Black" />
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisual}" />
            <Setter Property="motion:ToggleFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="CheckVisual" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ThumbScale" />
                                </Grid.RenderTransform>
                                <Border x:Name="CheckWell" CornerRadius="6" Background="{DynamicResource GlassControlBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1.1" />
                                <Border x:Name="CheckCap" Margin="1.6,1.5,1.6,2.5" CornerRadius="4.4" Background="{DynamicResource GlassHoverBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="0.8" Opacity="0.55" IsHitTestVisible="False" />
                                <Grid x:Name="TrackActive" Opacity="0" IsHitTestVisible="False">
                                    <Border CornerRadius="6" Background="{DynamicResource GlassAccentBrush}" Opacity="0.16" />
                                    <Border CornerRadius="6" BorderBrush="{DynamicResource GlassAccentBrush}" BorderThickness="1.2" />
                                    <Border Margin="2.4" CornerRadius="3.8" Background="{DynamicResource GlassAccentBrush}" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="CheckCoreScale" ScaleX="0.52" ScaleY="0.52" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Canvas Width="20" Height="20" IsHitTestVisible="False">
                                    <Path x:Name="CheckMark" Data="M 5.5,10.3 L 8.6,13.5 L 14.6,6.8" Stroke="{DynamicResource GlassAccentTextBrush}" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="8,10" StrokeDashOffset="7.6" Opacity="0" />
                                </Canvas>
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckCap" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassProgress" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border CornerRadius="2" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="MainSurface">
        <Border.OpacityMask>
            <DrawingBrush x:Name="FrameMask" ViewboxUnits="Absolute" ViewportUnits="Absolute" Stretch="Fill">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup x:Name="FrameClip" FillRule="Nonzero" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Border.OpacityMask>
        <Grid x:Name="ShellRoot" Background="{DynamicResource GlassWindowBrush}">
            <Grid x:Name="WorkspaceGrid" Margin="0,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <glass:GlassSurface x:Name="NavigationSurface" Width="64" HorizontalAlignment="Right" CornerRadius="12" Background="{DynamicResource GlassChromeBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1" BlurRadius="0" TintOpacity="0.48" HighlightOpacity="0" PaintsWallpaper="False" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                    <Grid x:Name="NavigationRailContent" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="62" />
                        </Grid.RowDefinitions>
                        <Border x:Name="AccountSurface" Grid.Row="2" Height="62" Panel.ZIndex="1">
                            <Button x:Name="AccountButton" Style="{StaticResource GlassCircleButton}" Width="{x:Static sys:Double.NaN}" Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" Margin="11,0,11,0" Padding="0" Click="AccountButton_Click" AutomationProperties.Name="当前账户">
                                <Grid>
                                    <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                        <TextBlock x:Name="AccountFallbackGlyph" Text="?" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="AccountAvatarImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" UseLayoutRounding="True" SnapsToDevicePixels="True" />
                                    </Grid>
                                    <TextBlock x:Name="AccountNameText" Style="{StaticResource GlassText}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="46,0,8,0" TextTrimming="CharacterEllipsis" Opacity="0" Visibility="Collapsed" RenderTransform="{StaticResource RailLabelTranslation}" />
                                </Grid>
                            </Button>
                        </Border>
                        <Grid x:Name="NavigationButtons" Grid.Row="1" VerticalAlignment="Top" Margin="8,12,8,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="NavigationButtonsTranslation" />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="52" />
                                <RowDefinition Height="52" />
                                <RowDefinition Height="52" />
                                <RowDefinition Height="52" />
                                <RowDefinition Height="52" />
                            </Grid.RowDefinitions>
                            <!-- Same-tone selection overlay; it slides between items on a spring. -->
                            <Border x:Name="NavSelection" Grid.RowSpan="6" Height="42" HorizontalAlignment="Stretch" VerticalAlignment="Top" CornerRadius="8" Background="{DynamicResource GlassSelectedBrush}" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavigationTranslation" />
                                </Border.RenderTransform>
                            </Border>
                            <Button x:Name="NavLaunch" Grid.Row="0" Style="{StaticResource GlassNavButton}" Height="42" Padding="0" HorizontalContentAlignment="Stretch" Tag="0" Click="NavigationButton_Click" ToolTip="启动" AutomationProperties.Name="启动">
                                <Grid>
                                    <Viewbox Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource GlassRailPath}" Data="{StaticResource IconPlay}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="NavLaunchText" Text="启动" FontSize="13.5" VerticalAlignment="Center" Margin="49,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextTrimming="CharacterEllipsis" Opacity="0" Visibility="Collapsed" RenderTransform="{StaticResource RailLabelTranslation}" />
                                </Grid>
                            </Button>
                            <Button x:Name="NavDownload" Grid.Row="1" Style="{StaticResource GlassNavButton}" Height="42" Padding="0" HorizontalContentAlignment="Stretch" Tag="1" Click="NavigationButton_Click" ToolTip="下载" AutomationProperties.Name="下载">
                                <Grid>
                                    <Viewbox Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource GlassRailPath}" Data="{StaticResource IconDownload}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="NavDownloadText" Text="下载" FontSize="13.5" VerticalAlignment="Center" Margin="49,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextTrimming="CharacterEllipsis" Opacity="0" Visibility="Collapsed" RenderTransform="{StaticResource RailLabelTranslation}" />
                                </Grid>
                            </Button>
                            <Button x:Name="NavFavorites" Grid.Row="2" Style="{StaticResource GlassNavButton}" Height="42" Padding="0" HorizontalContentAlignment="Stretch" Tag="10" Click="NavigationButton_Click" ToolTip="收藏" AutomationProperties.Name="收藏">
                                <Grid>
                                    <Viewbox Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource GlassRailPath}" Data="{StaticResource IconHeart}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="NavFavoritesText" Text="收藏" FontSize="13.5" VerticalAlignment="Center" Margin="49,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextTrimming="CharacterEllipsis" Opacity="0" Visibility="Collapsed" RenderTransform="{StaticResource RailLabelTranslation}" />
                                </Grid>
                            </Button>
                            <Button x:Name="NavLink" Grid.Row="3" Style="{StaticResource GlassNavButton}" Height="42" Padding="0" HorizontalContentAlignment="Stretch" Tag="2" Click="NavigationButton_Click" ToolTip="联机" AutomationProperties.Name="联机">
                                <Grid>
                                    <Viewbox Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource GlassRailPath}" Data="M10,13 L14,9 M8,16 L7,17 C5.5,18.5 3,18.5 1.5,17 C0,15.5 0,13 1.5,11.5 L6.5,6.5 C8,5 10.5,5 12,6.5 M12,15.5 C13.5,17 16,17 17.5,15.5 L22.5,10.5 C24,9 24,6.5 22.5,5 C21,3.5 18.5,3.5 17,5 L16,6" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="NavLinkText" Text="联机" FontSize="13.5" VerticalAlignment="Center" Margin="49,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextTrimming="CharacterEllipsis" Opacity="0" Visibility="Collapsed" RenderTransform="{StaticResource RailLabelTranslation}" />
                                </Grid>
                            </Button>
                            <Button x:Name="NavSettings" Grid.Row="4" Style="{StaticResource GlassNavButton}" Height="42" Padding="0" HorizontalContentAlignment="Stretch" Tag="3" Click="NavigationButton_Click" ToolTip="设置" AutomationProperties.Name="设置">
                                <Grid>
                                    <Viewbox Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource GlassRailPath}" Data="{StaticResource IconSettings}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="NavSettingsText" Text="设置" FontSize="13.5" VerticalAlignment="Center" Margin="49,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextTrimming="CharacterEllipsis" Opacity="0" Visibility="Collapsed" RenderTransform="{StaticResource RailLabelTranslation}" />
                                </Grid>
                            </Button>
                            <Button x:Name="NavOther" Grid.Row="5" Style="{StaticResource GlassNavButton}" Height="42" Padding="0" HorizontalContentAlignment="Stretch" Tag="4" Click="NavigationButton_Click" ToolTip="更多" AutomationProperties.Name="更多">
                                <Grid>
                                    <Viewbox Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource GlassRailPath}" Data="{StaticResource IconMore}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="NavOtherText" Text="更多" FontSize="13.5" VerticalAlignment="Center" Margin="49,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextTrimming="CharacterEllipsis" Opacity="0" Visibility="Collapsed" RenderTransform="{StaticResource RailLabelTranslation}" />
                                </Grid>
                            </Button>
                        </Grid>
                        <Button x:Name="RailToggleButton" Grid.Row="1" Style="{StaticResource GlassNavButton}" Height="40" Padding="0" Margin="8,0,8,4" VerticalAlignment="Bottom" HorizontalContentAlignment="Stretch" Click="RailToggleButton_Click" ToolTip="展开导航栏" AutomationProperties.Name="展开导航栏">
                            <Grid>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform>
                                        <RotateTransform x:Name="RailToggleRotation" />
                                    </Viewbox.RenderTransform>
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource GlassRailPath}" Data="{StaticResource IconBack}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="RailToggleText" Text="收起侧栏" FontSize="13" VerticalAlignment="Center" Margin="49,0,10,0" Foreground="{DynamicResource GlassSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Opacity="0" Visibility="Collapsed" RenderTransform="{StaticResource RailLabelTranslation}" />
                            </Grid>
                        </Button>
                        <Grid x:Name="NavigationHeaderEndcap" Grid.Row="0" Height="62">
                            <Image x:Name="AppLogoImage" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Stretch="Uniform" IsHitTestVisible="False" />
                            <TextBlock x:Name="RailBrandText" Style="{StaticResource GlassText}" FontFamily="{StaticResource GlassBrandFont}" Text="PCL-LF" FontSize="15.5" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" Margin="57,0,12,0" TextTrimming="CharacterEllipsis" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransform="{StaticResource RailLabelTranslation}" />
                        </Grid>
                    </Grid>
                </glass:GlassSurface>
                <Grid x:Name="BodyPresentation" Grid.Column="2">
                <Border x:Name="BodyFrame" CornerRadius="12" Background="Transparent" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1">
                    <Grid x:Name="BodyContentRoot" Background="Transparent" MouseLeftButtonDown="AccountWorkspace_MouseLeftButtonDown">
                        <Grid x:Name="BodyBackdropLayer" Background="Transparent" IsHitTestVisible="False">
                            <Grid x:Name="WallpaperViewport" ClipToBounds="True" IsHitTestVisible="False">
                                <Image x:Name="WallpaperImage" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed" />
                                <Border x:Name="ModalVideoFrost" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Border.Background>
                                        <ImageBrush Opacity="{Binding Opacity, ElementName=WallpaperImage}" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <glass:GlassSurface x:Name="ApplicationBackdrop" Background="{DynamicResource GlassMainBrush}" BorderThickness="0" CornerRadius="11" BlurRadius="0" TintOpacity="1" HighlightOpacity="0" PaintsWallpaper="False" IsHitTestVisible="False" />
                            <StackPanel x:Name="DevelopmentMark" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,14,10" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock Text="DevEdition" Style="{StaticResource GlassText}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" />
                                <TextBlock x:Name="DevelopmentBaseline" Style="{StaticResource GlassText}" FontSize="10" TextAlignment="Right"
                                           Foreground="{DynamicResource GlassSecondaryTextBrush}" />
                                <TextBlock x:Name="DevelopmentBuildTime" Style="{StaticResource GlassText}" FontSize="10" TextAlignment="Right"
                                           Foreground="{DynamicResource GlassSecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                        <!-- Startup splash: solid frosted glass in the theme's tone with the brand mark, name and a loader. Shown only while
                             GlassLauncherView.BeginSplash runs; it sits above all body content and leaves once loading has finished. -->
                        <Grid x:Name="SplashLayer" Panel.ZIndex="60" Visibility="Collapsed">
                            <glass:GlassSurface x:Name="SplashGlass" CornerRadius="11" BorderThickness="0" BlurRadius="48" TintOpacity="1" HighlightOpacity="0" Background="{DynamicResource GlassSplashBrush}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image x:Name="SplashLogo" Width="96" Height="96" Stretch="Uniform" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform><ScaleTransform x:Name="SplashLogoScale" ScaleX="0.6" ScaleY="0.6" /></Image.RenderTransform>
                                </Image>
                                <StackPanel x:Name="SplashStatusContent">
                                    <TextBlock x:Name="SplashTitle" Text="PCL Living Fork" FontFamily="{StaticResource GlassDisplayFont}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0" Opacity="0" Foreground="{DynamicResource GlassTextBrush}">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="SplashTitleShift" Y="14" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <glass:BlockCurveLoader x:Name="SplashLoader" Width="40" Height="40" Margin="0,30,0,0" Opacity="0" IsActive="False" Foreground="{DynamicResource GlassTextBrush}" />
                                    <TextBlock x:Name="SplashStage" FontSize="13" Margin="0,14,0,0" HorizontalAlignment="Center" Opacity="0" Foreground="{DynamicResource GlassSecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="WorkspaceContentLayer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SecondaryColumn" Width="254" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <glass:GlassSurface x:Name="SecondarySurface" Grid.Column="0" Margin="24,24,0,24" CornerRadius="12" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1" BlurRadius="36" TintOpacity="0.72" HighlightOpacity="0">
                                <Grid x:Name="SecondaryContent" Margin="12,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="70" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="52" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="ContextStrip" Background="Transparent">
                                        <Grid>
                                            <TextBlock x:Name="SecondaryTitleText" Style="{StaticResource GlassText}" FontFamily="{StaticResource GlassDisplayFont}" Text="主页" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Top" Margin="10,18,10,0" />
                                            <TextBlock x:Name="WorkspaceHint" Opacity="0" IsHitTestVisible="False" />
                                            <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ExpandButtonContainer" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Grid.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="ExpandAvailabilityScale" />
                                                        <TranslateTransform x:Name="ExpandTranslation" />
                                                    </TransformGroup>
                                                </Grid.RenderTransform>
                                                <Button x:Name="ExpandButton" Style="{StaticResource GlassCircleButton}" Width="36" Height="36" Padding="9" Click="ExpandButton_Click" ToolTip="启动选项" AutomationProperties.Name="展开启动选项">
                                                    <Path Style="{StaticResource GlassPath}" Data="M12,4 V20 M4,12 H20" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="ExpandRotation" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="SideRail" Grid.Row="1" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="RailTranslation" />
                                        </Border.RenderTransform>
                                        <ScrollViewer x:Name="SidebarScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" motion:SmoothScroll.IsEnabled="True">
                                            <Grid x:Name="SidebarHost">
                                                <!-- One same-tone overlay slides between sidebar rows on a spring (rows draw no selection of their own). -->
                                                <Border x:Name="SidebarSelection" Height="36" VerticalAlignment="Top" CornerRadius="8" Background="{DynamicResource GlassListSelectedBrush}" IsHitTestVisible="False" Opacity="0">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="SidebarSelectionTranslation" />
                                                    </Border.RenderTransform>
                                                </Border>
                                                <StackPanel x:Name="SidebarPanel" />
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                    <Grid Grid.Row="2" x:Name="PrimaryActions">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="38" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SelectInstanceButton" Style="{StaticResource GlassCircleButton}" Padding="10" Margin="0" FontSize="11" Click="SelectInstanceButton_Click" AutomationProperties.Name="选择实例" Width="38" Height="38" Grid.Column="0">
                                            <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconGrid}" />
                                        </Button>
                                        <Button x:Name="InstanceSettingsButton" Grid.Column="2" Style="{StaticResource GlassCircleButton}" Padding="10" Margin="0" FontSize="11" Click="InstanceSettingsButton_Click" AutomationProperties.Name="实例设置" Width="38" Height="38">
                                            <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconSettings}" />
                                        </Button>
                                    </Grid>
                                    <Border x:Name="PrimaryCard" MaxWidth="360" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0" Background="Transparent" BorderThickness="0" Grid.Row="1">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="PrimaryScale" />
                                                <TranslateTransform x:Name="PrimaryTranslation" />
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <StackPanel x:Name="InstanceCenter" HorizontalAlignment="Stretch">
                                            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                                <Image x:Name="InstanceImage" Width="64" Height="64" Stretch="Uniform" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="InstanceNameText" Style="{StaticResource GlassText}" FontFamily="{StaticResource GlassDisplayFont}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
                                            <TextBlock x:Name="InstanceDescriptionText" Style="{StaticResource GlassText}" FontSize="13" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource GlassSecondaryTextBrush}" Margin="0,4,0,0" />
                                            <Button x:Name="LaunchButton" Style="{StaticResource GlassLaunchButton}" Width="190" Height="48" HorizontalAlignment="Center" Margin="0,22,0,0" Click="LaunchButton_Click" AutomationProperties.Name="启动游戏">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path x:Name="LaunchGlyph" Data="{StaticResource IconPlay}" Fill="{Binding Foreground,ElementName=LaunchButton}" Width="13" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                                    <TextBlock x:Name="LaunchButtonText" Text="启动游戏" FontSize="17" FontWeight="SemiBold" Foreground="{Binding Foreground,ElementName=LaunchButton}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock x:Name="LaunchStatusText" Style="{StaticResource GlassText}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Visibility="Collapsed" />
                                            <ProgressBar x:Name="LaunchProgressBar" Style="{StaticResource GlassProgress}" MaxWidth="210" HorizontalAlignment="Stretch" Height="4" Maximum="1" Foreground="{DynamicResource GlassAccentBrush}" Background="{DynamicResource GlassControlBrush}" Margin="0,8,0,0" Visibility="Collapsed" />
                                            <!-- Recent world lives under the launch button permanently: a compact glass row with the world thumbnail, its name
                                                 and a play affordance, styled as a secondary companion of the primary launch action. -->
                                            <Border x:Name="RecentWorldCard" MaxWidth="252" HorizontalAlignment="Stretch" Margin="0,18,0,0">
                                                <Grid>
                                                    <Button x:Name="RecentWorldButton" Cursor="Hand" Click="RecentWorldButton_Click" AutomationProperties.Name="继续上次游玩的世界" ToolTip="继续游玩">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Chrome" CornerRadius="12" Background="{DynamicResource GlassSelectedBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1" Padding="8,7,12,7" RenderTransformOrigin="0.5,0.5">
                                                                    <Border.RenderTransform><ScaleTransform x:Name="Press" /></Border.RenderTransform>
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassListSelectedBrush}" /></Trigger>
                                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter></Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource GlassOutlineBrush}">
                                                                <Grid>
                                                                    <Path x:Name="WorldFallbackGlyph" Data="{StaticResource IconWorld}" Stroke="{DynamicResource GlassSecondaryTextBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="8" />
                                                                    <Image x:Name="RecentWorldImage" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8" /></Image.Clip></Image>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource GlassText}" Text="继续游玩" FontSize="11" Foreground="{DynamicResource GlassSecondaryTextBrush}" />
                                                                <TextBlock x:Name="RecentWorldNameText" Style="{StaticResource GlassText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                                <TextBlock x:Name="RecentWorldDetailText" Style="{StaticResource GlassText}" FontSize="11" Foreground="{DynamicResource GlassSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                                            </StackPanel>
                                                            <Path Grid.Column="2" Data="{StaticResource IconPlay}" Fill="{DynamicResource GlassSecondaryTextBrush}" Width="9" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                    <TextBlock x:Name="NoRecentWorldText" Style="{StaticResource GlassText}" Text="暂无最近游玩的世界" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource GlassSecondaryTextBrush}" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <!-- Startup options drop down inside the home panel, above the instance, when the header plus is pressed. -->
                                    <Grid x:Name="AuxiliaryCards" Grid.Row="1" Panel.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,2,0,0" MaxWidth="256" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="AuxiliaryTranslation" />
                                        </Grid.RenderTransform>
                                        <Border x:Name="DependencyCard" CornerRadius="12" Background="{DynamicResource GlassSelectedBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource GlassText}" Text="启动前检查" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                                <CheckBox x:Name="DependencyCheckBox" Style="{StaticResource GlassCheckBox}" Content="检查模组依赖" Checked="DependencyCheckBox_Changed" Unchecked="DependencyCheckBox_Changed" AutomationProperties.Name="启动时检查模组依赖" />
                                                <CheckBox x:Name="AutoFillCheckBox" Content="自动补全依赖" Checked="AutoFillCheckBox_Changed" Unchecked="AutoFillCheckBox_Changed" AutomationProperties.Name="自动补全模组依赖">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource GlassCheckBox}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=DependencyCheckBox}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </glass:GlassSurface>
                            <!-- Account workspace (opened from the rail avatar): a side card over the secondary panel and a scene
                                 over the main column. Both stay hidden until the shell supplies content and opens it. -->
                            <glass:GlassSurface x:Name="AccountSideSurface" Grid.Column="0" Panel.ZIndex="5" Margin="24,24,0,24" CornerRadius="12" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1" BlurRadius="36" TintOpacity="0.72" HighlightOpacity="0" Visibility="Hidden" Opacity="0" IsHitTestVisible="False">
                                <glass:GlassSurface.RenderTransform><TranslateTransform x:Name="AccountSideTranslation" /></glass:GlassSurface.RenderTransform>
                                <ContentControl x:Name="AccountSideHost" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                            </glass:GlassSurface>
                            <ContentControl x:Name="AccountSceneHost" Grid.Column="1" Panel.ZIndex="5" Margin="24,24,24,24" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Hidden" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <ContentControl.RenderTransform><TransformGroup><ScaleTransform x:Name="AccountSceneScale" /><TranslateTransform x:Name="AccountSceneTranslation" /></TransformGroup></ContentControl.RenderTransform>
                            </ContentControl>
                            <Grid x:Name="MainColumn" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="PageHeaderRow" Height="60" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Header" Background="Transparent" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid x:Name="PageHeading" Height="36" VerticalAlignment="Center" Margin="24,0,100,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="BackTitlePanel" Width="36" Margin="0,0,4,0" Visibility="Collapsed">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="BackTitleTranslation" />
                                                </Grid.RenderTransform>
                                                <!-- Same colourless feathered blur as the title backing, so the back arrow stays readable over a wallpaper. -->
                                                <glass:GlassSurface Margin="-8" CornerRadius="26" BorderThickness="0" BlurRadius="24" TintOpacity="1" HighlightOpacity="0" Background="Transparent" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=PageTitleBacking}">
                                                    <glass:GlassSurface.Effect><BlurEffect Radius="10" RenderingBias="Performance" /></glass:GlassSurface.Effect>
                                                </glass:GlassSurface>
                                                <Button Style="{StaticResource GlassCircleButton}" Click="BackButton_Click" AutomationProperties.Name="返回上一页">
                                                    <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconBack}" />
                                                </Button>
                                            </Grid>
                                            <Grid Grid.Column="1" HorizontalAlignment="Left">
                                                <!-- Over a launcher wallpaper the title gets a feathered frosted backing so it stays readable. -->
                                                <glass:GlassSurface x:Name="PageTitleBacking" Style="{StaticResource GlassPageTitleFrost}" Visibility="Collapsed" Opacity="{Binding Opacity, ElementName=PageTitleText}" />
                                                <TextBlock x:Name="PageTitleText" Style="{StaticResource GlassText}" FontFamily="{StaticResource GlassDisplayFont}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Grid x:Name="WorkspaceSurface" Grid.Row="1" Background="Transparent">
                                    <Grid x:Name="MainContentGrid" Margin="24,0,24,24" MaxWidth="920">
                                        <Grid x:Name="HomePanel">
                                            <Grid.RenderTransform>
                                                <TranslateTransform x:Name="HomeTranslation" />
                                            </Grid.RenderTransform>
                                            <Grid x:Name="HomeDeck" SizeChanged="HomeDeck_SizeChanged">
                                            </Grid>
                                        </Grid>
                                        <Grid x:Name="PageScene">
                                            <ContentControl x:Name="PageContent" Visibility="Hidden" IsHitTestVisible="False" Focusable="True" IsTabStop="False"
                                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                            <ContentControl x:Name="AlternatePageContent" Visibility="Hidden" IsHitTestVisible="False" Focusable="True" IsTabStop="False"
                                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                    <Image x:Name="CrashBodySnapshot" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Grid>
            <Grid x:Name="WindowControlsSurface" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <Canvas x:Name="WindowControlsWallpaperFrost" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid x:Name="WindowControlsBodyFrost" IsHitTestVisible="False">
                        <Grid.Effect>
                            <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
                        </Grid.Effect>
                        <Border x:Name="WindowControlsBodyFrostBase" CornerRadius="0,12,0,0" />
                        <Border x:Name="WindowControlsBodyFrostVisual" CornerRadius="0,12,0,0">
                            <Border.Background>
                                <VisualBrush x:Name="WindowControlsBodyBrush" Stretch="Fill" ViewboxUnits="Absolute" AlignmentX="Left" AlignmentY="Top" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Canvas>
                <glass:GlassSurface x:Name="WindowControlsChrome" CornerRadius="12" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1" Padding="5" BlurRadius="0" TintOpacity="0.78" HighlightOpacity="0" PaintsWallpaper="False">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ThemeToggleButton" Style="{StaticResource GlassCircleButton}" Margin="0,0,4,0" Click="ThemeToggleButton_Click" ToolTip="切换到浅色主题" AutomationProperties.Name="切换到浅色主题">
                            <Path x:Name="ThemeToggleGlyph" Style="{StaticResource GlassPath}" Data="{StaticResource IconThemeSun}" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="MinimizeButton" Style="{StaticResource GlassCircleButton}" Margin="0,0,4,0" Click="MinimizeButton_Click" ToolTip="最小化" AutomationProperties.Name="最小化窗口">
                            <Border Width="14" Height="1.5" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource GlassCircleButton}" Click="CloseButton_Click" ToolTip="关闭" AutomationProperties.Name="关闭窗口">
                            <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconClose}" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </glass:GlassSurface>
            </Grid>
            <!-- Bottom-right dock (background music): the window controls' twin at the bottom-right corner. The same chrome over the same
                 blurred slice of the body, and the body is notched around it the same way. -->
            <music:GlassMusicSurface x:Name="MusicDockSurface" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" />
            <glass:GlassSurface x:Name="AccountPopover" Panel.ZIndex="10" glass:GlassMaterial.IsEnabled="False" Width="320" MaxHeight="480" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="84,0,0,16" CornerRadius="12" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource GlassOutlineBrush}" BorderThickness="1" BlurRadius="24" TintOpacity="0.97" HighlightOpacity="0" Padding="18" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0,1">
                <glass:GlassSurface.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AccountPopoverScale" />
                        <TranslateTransform x:Name="AccountPopoverTranslation" />
                    </TransformGroup>
                </glass:GlassSurface.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource GlassText}" Text="账户" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
                    <Button Style="{StaticResource GlassCircleButton}" HorizontalAlignment="Right" Click="CloseAccountButton_Click" AutomationProperties.Name="关闭账户面板">
                        <Path Style="{StaticResource GlassPath}" Data="{StaticResource IconClose}" Width="12" Height="12" />
                    </Button>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                        <ContentControl x:Name="AccountContent" HorizontalContentAlignment="Stretch" />
                    </ScrollViewer>
                </Grid>
            </glass:GlassSurface>
        </Grid>
    </Border>
</UserControl>
