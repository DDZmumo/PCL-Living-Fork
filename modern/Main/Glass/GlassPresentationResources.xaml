<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:glass="clr-namespace:PCLLF.Wpf.Glass;assembly=PCLLF.WPF.Core"
    xmlns:motion="clr-namespace:PCLLF.Wpf.Motion;assembly=PCLLF.WPF.Core">
    <SolidColorBrush x:Key="GlassPresentationText" Color="#FF202B3A" />
    <SolidColorBrush x:Key="GlassPresentationSecondary" Color="#FF697685" />
    <SolidColorBrush x:Key="GlassPresentationFill" Color="#DFF5F6F8" />
    <SolidColorBrush x:Key="GlassPresentationField" Color="#EFFFFFFF" />
    <SolidColorBrush x:Key="GlassPresentationHover" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="GlassPresentationSelected" Color="#26007AFF" />
    <SolidColorBrush x:Key="GlassPresentationEdge" Color="#2635475B" />
    <SolidColorBrush x:Key="GlassPresentationInputEdge" Color="Transparent" />
    <SolidColorBrush x:Key="GlassPresentationFocusEdge" Color="#5A000000" />
    <SolidColorBrush x:Key="GlassPresentationPressed" Color="#FFCFD1D5" />
    <SolidColorBrush x:Key="GlassPresentationDanger" Color="#FFC65251" />
    <SolidColorBrush x:Key="GlassPresentationTrack" Color="#4059687B" />
    <SolidColorBrush x:Key="GlassPresentationThumbFill" Color="#F4FFFFFF" />
    <SolidColorBrush x:Key="GlassPresentationAccent" Color="#FF007AFF" />
    <SolidColorBrush x:Key="GlassPresentationOnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="GlassPresentationPopup" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="GlassPresentationSeparator" Color="#1635475B" />
    <SolidColorBrush x:Key="GlassPresentationFieldFocused" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="GlassPresentationControlStroke" Color="#1A000000" />
    <SolidColorBrush x:Key="GlassPresentationAccentStroke" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="GlassPresentationDockFill" Color="#EBFCFDFF" />
    <SolidColorBrush x:Key="GlassPresentationDockEdge" Color="#2635475B" />
    <SolidColorBrush x:Key="GlassPresentationDockBadgeFill" Color="#18007AFF" />
    <SolidColorBrush x:Key="GlassPresentationDialogFill" Color="#D6FAFAFB" />
    <SolidColorBrush x:Key="GlassPresentationDialogEdge" Color="#2635475B" />
    <SolidColorBrush x:Key="GlassPresentationWarnFill" Color="#DEFDEDED" />
    <SolidColorBrush x:Key="GlassPresentationWarnEdge" Color="#78E25450" />
    <SolidColorBrush x:Key="GlassPresentationWarnText" Color="#FFC4302E" />
    <FontFamily x:Key="GlassPresentationFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="GlassPresentationDisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <CornerRadius x:Key="GlassPresentationCardRadius">14</CornerRadius>
    <CornerRadius x:Key="GlassPresentationFieldRadius">10</CornerRadius>
    <Style x:Key="GlassPresentationFocus">
        <Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border Margin="2" CornerRadius="10" BorderBrush="{DynamicResource GlassPresentationText}" BorderThickness="2" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassPresentationTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" /><Setter Property="FontFamily" Value="{StaticResource GlassPresentationFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <ControlTemplate x:Key="GlassPresentationPlainButtonTemplate" TargetType="Button">
        <Grid>
            <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="Interaction" CornerRadius="8" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Interaction" Property="Opacity" Value="0.07" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Interaction" Property="Opacity" Value="0.12" /><Setter TargetName="Label" Property="Opacity" Value="0.78" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource GlassPresentationFocusEdge}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="GlassPresentationButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" />
        <Setter Property="Background" Value="{DynamicResource GlassPresentationField}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassPresentationControlStroke}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="16,6" />
        <Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="{StaticResource GlassPresentationFont}" />
        <Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{StaticResource GlassPresentationFocus}" />
        <Setter Property="motion:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid>
                <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                <Border x:Name="Interaction" CornerRadius="8" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True">
                    <!-- Text content must inherit the button's Foreground. The application-wide TextBlock style forces the
                         original theme colour, which painted the accent button's label white on its light fill. -->
                    <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><Setter Property="FontFamily" Value="{StaticResource GlassPresentationFont}" /></Style></ContentPresenter.Resources>
                </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Interaction" Property="Opacity" Value="0.07" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Interaction" Property="Opacity" Value="0.12" /><Setter TargetName="Label" Property="Opacity" Value="0.8" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource GlassPresentationFocusEdge}" /></Trigger>
                <!-- Disabled dims the label more than the surface, so the text still separates from its fill over a wallpaper. -->
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Label" Property="Opacity" Value="0.55" /><Setter TargetName="Surface" Property="Opacity" Value="0.75" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Prominent action: system-blue fill with a white label (at most one per view). -->
    <Style x:Key="GlassPresentationAccentButton" TargetType="Button" BasedOn="{StaticResource GlassPresentationButton}">
        <!-- Primary action: a brighter pane of the same glass with a bold label (no opaque slab). -->
        <Setter Property="Background" Value="{DynamicResource GlassPresentationPrimaryFill}" /><Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassPresentationPrimaryEdge}" /><Setter Property="FontWeight" Value="SemiBold" />
        <!-- Disabled: a faded light accent with a faded dark label had almost no contrast over a wallpaper.
             Fall back to the neutral control surface with normal text; the template's dimming still marks it unavailable. -->
        <Style.Triggers><Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="{DynamicResource GlassPresentationField}" /><Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassPresentationControlStroke}" />
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="GlassPresentationDockButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,0,10,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource GlassPresentationFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassPresentationFocus}" />
        <Setter Property="motion:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Interaction" CornerRadius="9" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Setter Property="FontFamily" Value="{StaticResource GlassPresentationFont}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Interaction" Property="Opacity" Value="0.09" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Interaction" Property="Opacity" Value="0.16" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource GlassPresentationFocusEdge}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassPresentationRowButton" TargetType="Button" BasedOn="{StaticResource GlassPresentationButton}"><Setter Property="Template" Value="{StaticResource GlassPresentationPlainButtonTemplate}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="12,6" /><Setter Property="MinHeight" Value="32" /></Style>
    <Style x:Key="GlassPresentationBandRow" TargetType="Button" BasedOn="{StaticResource GlassPresentationRowButton}"><Setter Property="MinHeight" Value="52" /><Setter Property="Padding" Value="8,6" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ListRow" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="ListRow" Property="Opacity" Value="0.76" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="GlassPresentationListAction" TargetType="Button" BasedOn="{StaticResource GlassPresentationRowButton}"><Setter Property="MinHeight" Value="52" /><Setter Property="Padding" Value="8,6" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ListRow" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ListRow" Property="Background" Value="{DynamicResource GlassPresentationSelected}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ListRow" Property="Opacity" Value="0.76" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="GlassPresentationRowSelector" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassPresentationFocus}" />
        <Setter Property="motion:ToggleFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ThumbScale" />
                            </Grid.RenderTransform>
                            <Border x:Name="CheckWell" CornerRadius="6" Background="{DynamicResource GlassPresentationField}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="1.1" />
                            <Border x:Name="CheckCap" Margin="1.6,1.5,1.6,2.5" CornerRadius="4.4" Background="{DynamicResource GlassPresentationHover}" BorderBrush="{DynamicResource GlassPresentationControlStroke}" BorderThickness="0.8" Opacity="0.72" IsHitTestVisible="False" />
                            <Grid x:Name="TrackActive" Opacity="0" IsHitTestVisible="False">
                                <Border CornerRadius="6" Background="{DynamicResource GlassPresentationAccent}" Opacity="0.16" />
                                <Border CornerRadius="6" BorderBrush="{DynamicResource GlassPresentationAccent}" BorderThickness="1.2" />
                                <Border Margin="2.4" CornerRadius="3.8" Background="{DynamicResource GlassPresentationAccent}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="CheckCoreScale" ScaleX="0.52" ScaleY="0.52" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Canvas Width="20" Height="20" IsHitTestVisible="False">
                                <Path x:Name="CheckMark" Data="M 5.5,10.3 L 8.6,13.5 L 14.6,6.8" Stroke="{DynamicResource GlassPresentationOnAccent}" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="8,10" StrokeDashOffset="7.6" Opacity="0" />
                            </Canvas>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckCap" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckWell" Property="BorderBrush" Value="{DynamicResource GlassPresentationFocusEdge}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassPresentationCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassPresentationFocus}" />
        <Setter Property="motion:ToggleFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ThumbScale" />
                            </Grid.RenderTransform>
                            <Border x:Name="CheckWell" CornerRadius="6" Background="{DynamicResource GlassPresentationField}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="1.1" />
                            <Border x:Name="CheckCap" Margin="1.6,1.5,1.6,2.5" CornerRadius="4.4" Background="{DynamicResource GlassPresentationHover}" BorderBrush="{DynamicResource GlassPresentationControlStroke}" BorderThickness="0.8" Opacity="0.72" IsHitTestVisible="False" />
                            <Grid x:Name="TrackActive" Opacity="0" IsHitTestVisible="False">
                                <Border CornerRadius="6" Background="{DynamicResource GlassPresentationAccent}" Opacity="0.16" />
                                <Border CornerRadius="6" BorderBrush="{DynamicResource GlassPresentationAccent}" BorderThickness="1.2" />
                                <Border Margin="2.4" CornerRadius="3.8" Background="{DynamicResource GlassPresentationAccent}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="CheckCoreScale" ScaleX="0.52" ScaleY="0.52" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Canvas Width="20" Height="20" IsHitTestVisible="False">
                                <Path x:Name="CheckMark" Data="M 5.5,10.3 L 8.6,13.5 L 14.6,6.8" Stroke="{DynamicResource GlassPresentationOnAccent}" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="8,10" StrokeDashOffset="7.6" Opacity="0" />
                            </Canvas>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckCap" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckWell" Property="BorderBrush" Value="{DynamicResource GlassPresentationFocusEdge}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlassPresentationSettingsCheckBox" TargetType="CheckBox" BasedOn="{StaticResource GlassPresentationCheckBox}">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="GlassPresentationRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" /><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="12,8" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource GlassPresentationFocus}" /><Setter Property="motion:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="RadioSurface" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioSurface" Property="Background" Value="{DynamicResource GlassPresentationSelected}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioSurface" Property="BorderBrush" Value="{DynamicResource GlassPresentationEdge}" /><Setter TargetName="RadioSurface" Property="BorderThickness" Value="0.7" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Exclusive option (MyRadioBox): a ring indicator rather than a filled pill, so selected and unselected options stay comparable. -->
    <Style x:Key="GlassPresentationRadioBox" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" /><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="0,6,14,6" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource GlassPresentationFocus}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse x:Name="RadioRing" Width="20" Height="20" Fill="{DynamicResource GlassPresentationField}" Stroke="{DynamicResource GlassPresentationSecondary}" StrokeThickness="1" VerticalAlignment="Center" />
                <Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="{DynamicResource GlassPresentationOnAccent}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden" />
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioRing" Property="Fill" Value="{DynamicResource GlassPresentationHover}" /></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioRing" Property="Fill" Value="{DynamicResource GlassPresentationAccent}" /><Setter TargetName="RadioRing" Property="Stroke" Value="{DynamicResource GlassPresentationAccent}" /><Setter TargetName="RadioDot" Property="Visibility" Value="Visible" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- TextBoxBase applies Padding to its own content host, so templates must not bind it again.
         An explicit (empty) style keeps the launcher-wide implicit ScrollViewer margins out of text inputs; Style="{x:Null}" would fall back to that implicit style. -->
    <Style x:Key="GlassPresentationInputHost" TargetType="ScrollViewer" />
    <Style x:Key="GlassPresentationTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" /><Setter Property="Background" Value="{DynamicResource GlassPresentationField}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlassPresentationText}" /><Setter Property="SelectionBrush" Value="{DynamicResource GlassPresentationAccent}" /><Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Padding" Value="12,0" /><Setter Property="MinHeight" Value="34" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" /><Setter Property="FontFamily" Value="{StaticResource GlassPresentationFont}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Grid>
                <Border x:Name="FieldSurface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GlassPresentationControlStroke}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource GlassPresentationInputHost}" /></Border>
                <Border x:Name="FocusLine" Height="2" Margin="6,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource GlassPresentationAccent}" Opacity="0" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldSurface" Property="Background" Value="{DynamicResource GlassPresentationHover}" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldSurface" Property="Background" Value="{DynamicResource GlassPresentationFieldFocused}" /><Setter TargetName="FocusLine" Property="Opacity" Value="1" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassPresentationComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" /><Setter Property="Padding" Value="14,6,12,6" /><Setter Property="MinHeight" Value="34" /><Setter Property="Margin" Value="0,1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Grid>
            <Border x:Name="ItemSurface" CornerRadius="6" Background="Transparent" />
            <Border x:Name="SelectionPill" Width="3" Height="16" CornerRadius="1.5" Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource GlassPresentationAccent}" Visibility="Hidden" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
        </Grid><ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource GlassPresentationHover}" /><Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource GlassPresentationHover}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassPresentationSearchBox" TargetType="TextBox" BasedOn="{StaticResource GlassPresentationTextBox}"><Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="32,0,32,0" /></Style>
    <Style x:Key="GlassPresentationPasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" /><Setter Property="CaretBrush" Value="{DynamicResource GlassPresentationText}" /><Setter Property="SelectionBrush" Value="{DynamicResource GlassPresentationAccent}" /><Setter Property="SelectionOpacity" Value="0.4" /><Setter Property="Padding" Value="12,8" /><Setter Property="MinHeight" Value="36" /><Setter Property="FontSize" Value="14" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Grid>
            <Border x:Name="FieldSurface" CornerRadius="8" Background="{DynamicResource GlassPresentationField}" BorderBrush="{DynamicResource GlassPresentationControlStroke}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource GlassPresentationInputHost}" /></Border>
            <Border x:Name="FocusLine" Height="2" Margin="6,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource GlassPresentationAccent}" Opacity="0" IsHitTestVisible="False" />
        </Grid><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldSurface" Property="Background" Value="{DynamicResource GlassPresentationHover}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldSurface" Property="Background" Value="{DynamicResource GlassPresentationFieldFocused}" /><Setter TargetName="FocusLine" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassPresentationComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" /><Setter Property="Background" Value="{DynamicResource GlassPresentationField}" />
        <Setter Property="MinHeight" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="{StaticResource GlassPresentationFont}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource GlassPresentationComboItem}" /><Setter Property="Padding" Value="12,0,36,0" />
        <Setter Property="MaxDropDownHeight" Value="300" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassPresentationFocus}" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
            <Border x:Name="ComboSurface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GlassPresentationControlStroke}" BorderThickness="1" />
            <Border x:Name="ComboInteraction" CornerRadius="8" Background="{DynamicResource GlassPresentationText}" Opacity="0" IsHitTestVisible="False" />
            <ToggleButton x:Name="DropDownButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent" /></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Path x:Name="Chevron" Data="M1,1 L6,6 11,1" Stroke="{DynamicResource GlassPresentationSecondary}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="6" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="ChevronRotation" /></Path.RenderTransform></Path>
            <ContentPresenter x:Name="SelectionContent" ClipToBounds="True" Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="12,0,36,0" Padding="0" Style="{x:Null}" Background="Transparent" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}" VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" CaretBrush="{DynamicResource GlassPresentationText}" SelectionBrush="{DynamicResource GlassPresentationAccent}"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></TextBox.Template></TextBox>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None" HorizontalOffset="-12">
                <Border x:Name="DropDownShadowHost" Padding="12,2,12,18" Background="Transparent">
                    <Grid glass:GlassPopupBackdrop.Enable="True" glass:GlassPopupBackdrop.CornerRadius="10">
                        <glass:GlassSurface x:Name="DropDownSurface" CornerRadius="10" Padding="4" BlurRadius="24" ExtendWallpaper="True"
                               Background="{DynamicResource GlassPresentationFill}" BorderBrush="{DynamicResource GlassPresentationEdge}" BorderThickness="1"
                               MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" RenderTransformOrigin="0.5,0">
                            <glass:GlassSurface.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.28" Color="Black" RenderingBias="Performance" /></glass:GlassSurface.Effect>
                            <glass:GlassSurface.RenderTransform><TransformGroup><ScaleTransform x:Name="DropDownScale" /><TranslateTransform x:Name="DropDownTranslation" /></TransformGroup></glass:GlassSurface.RenderTransform>
                            <ScrollViewer x:Name="DropDownScroll" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                        </glass:GlassSurface>
                    </Grid>
                </Border>
            </Popup>
        </Grid><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboInteraction" Property="Opacity" Value="0.06" /></Trigger>
            <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /><Setter TargetName="SelectionContent" Property="Visibility" Value="Hidden" /></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="ComboInteraction" Property="Opacity" Value="0.1" />
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="DropDownSurface" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="DropDownTranslation" Storyboard.TargetProperty="Y" From="-8" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="DropDownScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource GlassPresentationFocusEdge}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassPresentationThumb" TargetType="Thumb"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Grid>
        <Ellipse Fill="{DynamicResource GlassPresentationField}" Stroke="{DynamicResource GlassPresentationControlStroke}" StrokeThickness="1" />
        <Ellipse x:Name="ThumbDot" Width="12" Height="12" Fill="{DynamicResource GlassPresentationAccent}" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform></Ellipse>
    </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbDot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.17" ScaleY="1.17" /></Setter.Value></Setter></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbDot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.83" ScaleY="0.83" /></Setter.Value></Setter></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="GlassPresentationTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" /></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="GlassPresentationSlider" TargetType="Slider"><Setter Property="MinHeight" Value="38" /><Setter Property="IsMoveToPointEnabled" Value="True" /><Setter Property="IsSnapToTickEnabled" Value="True" /><Setter Property="TickFrequency" Value="1" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Margin="0,0,0,0"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource GlassPresentationAccent}" Style="{StaticResource GlassPresentationTrackButton}" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource GlassPresentationThumb}" /></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="{DynamicResource GlassPresentationTrack}" Style="{StaticResource GlassPresentationTrackButton}" /></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <!-- Disclosure section: the header is plain text with a round chevron badge on the right instead of PCL's filled title bar.
         Hover only lifts the badge and text; expanding turns the chevron with a slight overshoot and fades in a hairline under the header. -->
    <Style x:Key="GlassPresentationExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" /><Setter Property="local:GlassExpandMotion.Enabled" Value="True" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
            <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" MinHeight="36" Margin="0" Padding="0,4" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand" FocusVisualStyle="{StaticResource GlassPresentationFocus}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="HeaderText" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Opacity="0.92" RenderTransformOrigin="0,0.5"></ContentPresenter>
                        <Grid Grid.Column="1" Width="26" Height="26" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Ellipse x:Name="ChevronBadge" Fill="{DynamicResource GlassPresentationTrack}" Opacity="0.55" />
                            <Path x:Name="Chevron" Data="M1,1 L5,5 9,1" Stroke="{DynamicResource GlassPresentationText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="5.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="ChevronTurn" Angle="-90" /></Path.RenderTransform></Path>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="-90" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChevronBadge" Property="Opacity" Value="1" /><Setter TargetName="HeaderText" Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderText" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.985" ScaleY="0.985" /></Setter.Value></Setter><Setter TargetName="ChevronBadge" Property="Opacity" Value="0.75" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></ToggleButton.Template>
                <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
            </ToggleButton>
            <Border x:Name="PART_BodyViewport" ClipToBounds="True"><StackPanel>
                <Border x:Name="HeaderRule" Height="1" Margin="0,8,0,0" Background="{DynamicResource GlassPresentationEdge}" Opacity="0" />
                <ContentPresenter x:Name="PART_BodyContent" Content="{TemplateBinding Content}" Margin="0,8,0,0" />
            </StackPanel></Border>
        </StackPanel><ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HeaderRule" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HeaderRule" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9" /><Setter Property="MinWidth" Value="0" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreasePage" Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource GlassPresentationSecondary}" Opacity="0.4" CornerRadius="3" Margin="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreasePage" Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
            </Track></Grid>
            <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="DecreasePage" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                <Setter TargetName="IncreasePage" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
            </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="9" /></Trigger></Style.Triggers>
    </Style>
    <!-- Tooltips use the shell's implicit frosted ToolTip style (GlassCommandChrome.ToolTipStyle), light or dark. -->
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource GlassPresentationText}" /><Setter Property="Padding" Value="10,8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource GlassPresentationSelected}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource GlassPresentationEdge}" /><Setter TargetName="Row" Property="BorderThickness" Value="0.6" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
