    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    x:Class="PCL.FormMain" Style="{StaticResource MyWindow}"
    AllowDrop="True" Topmost="True" Title="{x:Static local:ModBase.LauncherDisplayName}" AllowsTransparency="True" MinHeight="560" MinWidth="980"
    ScrollViewer.VerticalScrollBarVisibility="Disabled" Icon="/LivingPCL;component/Images/Branding/LivingPCL.ico" WindowStyle="None"
