<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <Grid>
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <StackPanel x:Name="PanCustom">
            </StackPanel>
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
    <local:MyCard x:Name="CardRecentWorlds" Title="上次游玩" Width="260" Height="78" Margin="20,0,0,20"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" Opacity="0" UseAnimation="False">
        <local:MyCard.RenderTransform>
            <TranslateTransform x:Name="TransRecentWorld" X="-24" />
        </local:MyCard.RenderTransform>
        <StackPanel x:Name="PanRecentWorlds" Margin="9,27,9,7">
            <local:MyListItem x:Name="ItemRecentWorld" Type="Clickable" IsScaleAnimationEnabled="False" Height="44"
                              Logo="/LivingPCL;component/Images/Blocks/Grass.png" />
        </StackPanel>
    </local:MyCard>
    </Grid>
</local:MyPageRight>
