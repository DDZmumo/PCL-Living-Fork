<Grid x:Class="WorldBackupGroup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PCL" Margin="0,0,0,10">
 <local:MyCard x:Name="CardBackups" Title="备份（0）" CanSwap="True" IsSwapped="True">
  <StackPanel x:Name="PanContent" Margin="15,40,15,15">
   <DockPanel Margin="5,0,5,8" LastChildFill="True">
    <local:MyIconTextButton x:Name="BtnCreate" Text="备份此存档" DockPanel.Dock="Right" Margin="10,0,0,0" />
    <TextBlock x:Name="LabState" VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap" />
   </DockPanel>
   <TextBlock x:Name="LabEmpty" Text="暂无备份，可先备份此存档。" Opacity="0.65" TextWrapping="Wrap" Margin="5,0,5,4" />
   <StackPanel x:Name="PanEntries" />
  </StackPanel>
 </local:MyCard>
</Grid>
