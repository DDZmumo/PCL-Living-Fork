<local:MyPageRight x:Class="PageInstanceKeybindings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,10">
                <local:MySearchBox x:Name="SearchBox" Margin="0,15" HintText="搜索按键 / 模组名 / 文件名" ToolTip="点击右侧键位按钮后重新绑定，Esc 取消。模组归属依据本地语言资源识别。" />
                <local:MyCard x:Name="CardBindings" Title=" " Margin="0,0,0,15" MinHeight="80">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,13,0,0" Height="28">
                        <local:MyRadioButton x:Name="BtnFilterAll" Text="全部" ColorType="Highlight" Checked="True" Margin="2,0" VerticalAlignment="Center" />
                        <local:MyRadioButton x:Name="BtnFilterConflicts" Text="同键占用" ColorType="Highlight" Margin="2,0" VerticalAlignment="Center" ToolTip="不同界面可能复用同一按键，同键占用不一定代表冲突。" />
                    </StackPanel>
                    <StackPanel Margin="20,48,20,20">
                        <TextBlock x:Name="LabEmpty" Opacity="0.65" TextWrapping="Wrap" Margin="5,0,5,8" />
                        <StackPanel x:Name="PanBindings" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyCard x:Name="CardCapture" Visibility="Collapsed" Opacity="0" Margin="25,25,25,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" UseAnimation="False">
            <local:MyCard.RenderTransform>
                <TranslateTransform x:Name="TransCapture" Y="-10" />
            </local:MyCard.RenderTransform>
            <TextBlock x:Name="LabCapture" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,9" Foreground="{DynamicResource ColorBrush2}" />
            <StackPanel Orientation="Horizontal" Margin="5,30,5,5" HorizontalAlignment="Center">
                <local:MyIconTextButton x:Name="BtnClear" Text="取消绑定" />
                <local:MyIconTextButton x:Name="BtnCancel" Text="取消修改" />
            </StackPanel>
        </local:MyCard>
        <local:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" UseAnimation="False">
            <local:MyLoading x:Name="Load" Text="正在读取按键和本地 Mod 信息" Margin="20,20,20,17" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>
