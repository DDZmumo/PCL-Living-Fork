<Grid x:Class="MyScreenshotItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" Margin="5,5,5,10" Background="Transparent">
 <local:MyCard UseAnimation="False">
  <StackPanel Margin="9">
   <Border CornerRadius="4" Background="{DynamicResource ColorBrushBg1}" Height="160" ClipToBounds="True">
    <Image x:Name="Thumbnail" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
   </Border>
   <TextBlock x:Name="LabName" Margin="3,8,3,3" FontSize="13.5" TextTrimming="CharacterEllipsis" />
   <TextBlock x:Name="LabInfo" Margin="3,0,3,3" FontSize="12" Foreground="{DynamicResource ColorBrushGray4}" TextTrimming="CharacterEllipsis" />
  </StackPanel>
 </local:MyCard>
 <Border x:Name="SelectionBorder" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush3}" IsHitTestVisible="False" Opacity="0" RenderTransformOrigin="0.5,0.5">
  <Border.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8" /></Border.RenderTransform>
 </Border>
 <local:MyCheckBox x:Name="Check" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" Height="22" ToolTip="选择截图" />
</Grid>
