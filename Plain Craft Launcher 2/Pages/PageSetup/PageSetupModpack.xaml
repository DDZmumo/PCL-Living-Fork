<local:MyPageRight x:Class="PageSetupModpack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard x:Name="CardLauncher" Title="启动器" Margin="0,15,0,15">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="22" /></Grid.RowDefinitions>
                        <TextBlock Text="启动器版本" VerticalAlignment="Center" Margin="0,0,25,0" />
                        <TextBlock x:Name="LabVersion" Grid.Column="1" VerticalAlignment="Center" />
                        <TextBlock Text="缓存文件夹" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextSystemCache" Grid.Row="2" Grid.Column="1" HintText="默认" local:SettingService.Key="SystemSystemCache"
                            ToolTip="下载、皮肤等缓存文件的存储位置。留空使用默认值，重启启动器后生效。">
                            <local:MyTextBox.ValidateRules><local:ValidateNullable /><local:ValidateFolderPath UseMinecraftCharCheck="False" /></local:MyTextBox.ValidateRules>
                        </local:MyTextBox>
                        <TextBlock Text="整合包模式" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,25,0" />
                        <local:MyCheckBox x:Name="CheckModpackMode" Text="启用" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
